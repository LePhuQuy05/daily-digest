# Copy this file to .env and paste your keys.
# The .env file is git-ignored; keys are never written to config.yaml or logs.

# OpenCode API key (required for LLM ranking/summaries)
# https://opencode.ai/console -> Account -> Personal API keys
OPENCODE_API_KEY=

# alphaXiv API key (optional — enables the community-upvotes "hot feed" source)
# Free: create an account at https://alphaxiv.org
ALPHAXIV_API_KEY=
