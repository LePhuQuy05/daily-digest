{# Story variants for the newsroom front page. Imported with context so
   `source_names` and the current digest context are available. #}

{% macro story_head(item, variant, cover=false, credit="") %}
  {% if variant == "hero" %}<div class="kicker">{{ t.story_kicker }}</div>{% endif %}
  <h3 class="story-title"><a href="{{ item.item.url | safe_href }}" target="_blank" rel="noopener noreferrer">{{ item.item.title }}</a></h3>
  {% if variant != "more" and item.why %}<p class="why">{{ item.why }}</p>{% endif %}
  {% if cover and credit %}<p class="story-credit">{{ credit }}</p>{% endif %}
{% endmacro %}

{% macro story(item, variant="brief") %}
{% set img = images.get(item.item.id) if images and variant in ("hero", "lead") else none %}
{% set cover = (variant == "hero" and img is not none and img.kind == "og" and img.credit != "" and img.height > 0 and img.width >= img.height * 1.25) %}
<article class="story story--{{ variant }}{% if img %} story--has-media{% endif %}{% if cover %} story--cover{% endif %}" id="story-{{ item.item.id }}" data-uid="{{ item.item.id }}" tabindex="-1">
  {% if variant == "hero" %}<div class="story-lede">{% endif %}
  {% if img %}
  <figure class="story-media story-media--{{ img.kind }}{% if img.height > img.width %} story-media--portrait{% endif %}">
    <img src="{{ img.data_uri }}" alt="{{ img.alt }}" width="{{ img.width }}" height="{{ img.height }}"{% if cover %} loading="eager" fetchpriority="high" onerror="this.closest('.story').classList.remove('story--cover');this.closest('.story').classList.add('story--cover-failed')"{% elif variant == "hero" %} loading="eager"{% else %} loading="lazy"{% endif %}>
    {% if img.credit and not cover %}<figcaption>{{ img.credit }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  {% if variant == "hero" %}
  <div class="story-head">{{ story_head(item, variant, cover, img.credit if img else "") }}</div>
  </div>
  {% else %}
  {{ story_head(item, variant) }}
  {% endif %}
  {% set summary_text = item.llm_summary or item.item.summary %}
  {% if variant != "more" and summary_text %}
  <p class="summary{% if item.llm_summary %} ai{% endif %}">{{ summary_text }}</p>
  {% endif %}
  <div class="meta">
    <span>{{ source_names.get(item.item.source, item.item.source) }}</span>
    {% if item.section == "papers" and item.item.published %}<span class="paper-date">{{ item.item.published | short_date }}</span>{% endif %}
    {% if item.item.points %}<span>{{ t.story_points.format(n=item.item.points) }}</span>{% endif %}
    {% if item.item.citations %}<span>{{ t.story_citations.format(n=item.item.citations) }}</span>{% endif %}
    {% if item.item.source == 'arxiv' %}<span class="tag-new">{{ t.story_new }}</span>{% endif %}
  </div>
  <div class="actions bridge-only">
    <button class="act" data-feedback="{{ item.item.id }}|like" title="{{ t.story_like_title }}" aria-label="{{ t.story_like_aria }}"><svg class="icon" aria-hidden="true"><use href="#i-thumb-up"/></svg></button>
    <button class="act" data-feedback="{{ item.item.id }}|dislike" title="{{ t.story_dislike_title }}" aria-label="{{ t.story_dislike_aria }}"><svg class="icon" aria-hidden="true"><use href="#i-thumb-down"/></svg></button>
    <button class="act" data-feedback="{{ item.item.id }}|save" title="{{ t.story_save_title }}" aria-label="{{ t.story_save_aria }}"><svg class="icon" aria-hidden="true"><use href="#i-bookmark"/></svg><span>{{ t.story_save }}</span></button>
  </div>
  <details class="ask">
    <summary>{{ t.story_ask_summary }}</summary>
    <div class="ask-row">
      <input class="ask-input" type="text" placeholder="{{ t.story_ask_placeholder }}" aria-label="{{ t.story_ask_aria }}">
      <button class="act ask-btn" data-ask="1" aria-label="{{ t.story_ask_question_aria }}"><svg class="icon" aria-hidden="true"><use href="#i-send"/></svg>{{ t.story_ask_button }}</button>
    </div>
    <div class="ask-answer" aria-live="polite"></div>
  </details>
</article>
{% endmacro %}

{% macro pinned_item(p) %}
<article class="story story--pinned" id="story-{{ p.uid }}" data-uid="{{ p.uid }}" tabindex="-1">
  <h3 class="story-title"><a href="{{ p.url | safe_href }}" target="_blank" rel="noopener noreferrer">{{ p.title }}</a></h3>
  <div class="meta">
    <span>{{ source_names.get(p.source, p.source) }}</span>
    {% if p.points %}<span>{{ t.story_points.format(n=p.points) }}</span>{% endif %}
    {% if p.citations %}<span>{{ t.story_citations.format(n=p.citations) }}</span>{% endif %}
  </div>
  <div class="actions bridge-only">
    <button class="act" data-feedback="{{ p.uid }}|unsave" title="{{ t.story_unsave_title }}" aria-label="{{ t.story_unsave_aria }}"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg><span>{{ t.story_done }}</span></button>
  </div>
</article>
{% endmacro %}

{% macro most_read() %}
{% if front_page.most_read %}
<section class="most-read">
  <h2>{{ t.most_read_title }}</h2>
  <ol>
    {% for r in front_page.most_read %}
    <li><a href="#story-{{ r.item.id }}">{{ r.item.title }}</a></li>
    {% endfor %}
  </ol>
</section>
{% endif %}
{% endmacro %}

{% macro rail() %}
<aside class="rail">
  {% if overview %}
  <section class="overview briefing" id="briefing" aria-label="{{ overview_label }}">
    <div class="briefing-head">
      <div class="kicker">{{ overview_label | upper }}</div>
      <div class="briefing-title">{{ t.overview_title }}</div>
    </div>
    <ul class="overview-points">
      {% if overview_points %}
      {% for point in overview_points %}
      <li class="overview-point{% if point.kind == 'takeaway' %} spotlight{% endif %}{% if point.kind == 'rest' %} overview-rest{% endif %}">
        <span class="overview-body">
          {% for seg in point.segments %}{{ seg.text }}{% if seg.ref %}<a class="oref" href="#story-{{ seg.ref.uid }}" data-story-ref="{{ seg.ref.uid }}" title="{{ seg.ref.title }}" aria-label="{{ t.overview_jump_aria.format(title=seg.ref.title) }}">{{ seg.ref.label }}</a>{% endif %}{% endfor %}
        </span>
      </li>
      {% endfor %}
      {% else %}
      {% set points = overview.split(". ") %}
      {% set shown_points = points[:3] + points[-1:] if points | length > 3 else points %}
      {% for point in shown_points %}
      <li class="overview-point{% if loop.last and loop.length > 1 %} spotlight{% endif %}">{{ point }}{% if not loop.last and not point.endswith(".") %}.{% endif %}</li>
      {% endfor %}
      {% endif %}
    </ul>
  </section>
  {% endif %}

  {% if pinned %}
  <section class="block pinned-block" id="pinned">
    <h2>{{ t.pinned_title }} <span class="pill">{{ pinned | length }}</span>{% if pinned_overflow %} <span class="pill">{{ t.pinned_older.format(n=pinned_overflow) }}</span>{% endif %}</h2>
    {% for p in pinned %}{{ pinned_item(p) }}{% endfor %}
  </section>
  {% endif %}

  <div class="source-line">
    {{ t.source_prefix }}
    {% for source, count in front_page.source_counts.items() %}{{ source_names.get(source, source) }} {{ count }}{% if not loop.last %} · {% endif %}{% endfor %}
  </div>
</aside>
{% endmacro %}
