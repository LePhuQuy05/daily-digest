{# Story variants for the newsroom front page. Imported with context so
   `source_names` and the current digest context are available. #}

{% macro story(item, variant="brief") %}
{% set img = images.get(item.item.id) if images and variant in ("hero", "lead") else none %}
<article class="story story--{{ variant }}{% if img %} story--has-media{% endif %}" id="story-{{ item.item.id }}" data-uid="{{ item.item.id }}">
  {% if img %}
  <figure class="story-media story-media--{{ img.kind }}{% if img.height > img.width %} story-media--portrait{% endif %}">
    <img src="{{ img.data_uri }}" alt="{{ img.alt }}" loading="lazy">
    {% if img.credit %}<figcaption>{{ img.credit }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  {% if variant == "hero" %}<div class="kicker">CÂU CHUYỆN CHÍNH</div>{% endif %}
  <h3 class="story-title"><a href="{{ item.item.url | safe_href }}" target="_blank" rel="noopener noreferrer">{{ item.item.title }}</a></h3>
  {% if variant != "more" and item.why %}<p class="why">{{ item.why }}</p>{% endif %}
  {% set summary_text = item.llm_summary or item.item.summary %}
  {% if variant != "more" and summary_text %}
  <p class="summary{% if item.llm_summary %} ai{% endif %}">{{ summary_text }}</p>
  {% endif %}
  <div class="meta">
    <span>{{ source_names.get(item.item.source, item.item.source) }}</span>
    {% if item.item.points %}<span>{{ item.item.points }} points</span>{% endif %}
    {% if item.item.citations %}<span>{{ item.item.citations }} citations</span>{% endif %}
    {% if item.item.source == 'arxiv' %}<span class="tag-new">MỚI</span>{% endif %}
  </div>
  <div class="actions bridge-only">
    <button class="act" data-feedback="{{ item.item.id }}|like" title="Digest này nên có nhiều bài thế này hơn" aria-label="Thích mục này"><svg class="icon" aria-hidden="true"><use href="#i-thumb-up"/></svg></button>
    <button class="act" data-feedback="{{ item.item.id }}|dislike" title="Bớt loại này ra" aria-label="Không thích mục này"><svg class="icon" aria-hidden="true"><use href="#i-thumb-down"/></svg></button>
    <button class="act" data-feedback="{{ item.item.id }}|save" title="Giữ lại trong mục Nhìn lại" aria-label="Lưu mục này vào Nhìn lại"><svg class="icon" aria-hidden="true"><use href="#i-bookmark"/></svg><span>Lưu</span></button>
  </div>
  <details class="ask">
    <summary>Hỏi biên tập</summary>
    <div class="ask-row">
      <input class="ask-input" type="text" placeholder="Hỏi thêm về mục này… (Ctrl+Enter)" aria-label="Nhập câu hỏi về mục này">
      <button class="act ask-btn" data-ask="1" aria-label="Hỏi về mục này"><svg class="icon" aria-hidden="true"><use href="#i-send"/></svg>Hỏi</button>
    </div>
    <div class="ask-answer" aria-live="polite"></div>
  </details>
</article>
{% endmacro %}

{% macro pinned_item(p) %}
<article class="story story--pinned" id="story-{{ p.uid }}" data-uid="{{ p.uid }}">
  <h3 class="story-title"><a href="{{ p.url | safe_href }}" target="_blank" rel="noopener noreferrer">{{ p.title }}</a></h3>
  <div class="meta">
    <span>{{ source_names.get(p.source, p.source) }}</span>
    {% if p.points %}<span>{{ p.points }} points</span>{% endif %}
    {% if p.citations %}<span>{{ p.citations }} citations</span>{% endif %}
  </div>
  <div class="actions bridge-only">
    <button class="act" data-feedback="{{ p.uid }}|unsave" title="Đọc xong, bỏ khỏi Nhìn lại" aria-label="Đọc xong, bỏ khỏi Nhìn lại"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg><span>Đọc xong</span></button>
  </div>
</article>
{% endmacro %}

{% macro rail() %}
<aside class="rail">
  {% if overview %}
  <section class="overview briefing" id="briefing" aria-label="{{ overview_label }}">
    <div class="briefing-head">
      <div class="kicker">{{ overview_label | upper }}</div>
      <div class="briefing-title">Trong ngày</div>
    </div>
    <ul class="overview-points">
      {% for point in overview.split(". ")[:4] %}
      <li class="overview-point{% if loop.last and loop.length > 1 %} spotlight{% endif %}">{{ point }}{% if not loop.last and not point.endswith(".") %}.{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if pinned %}
  <section class="block pinned-block" id="pinned">
    <h2>Nhìn lại <span class="pill">{{ pinned | length }}</span>{% if pinned_overflow %} <span class="pill">+{{ pinned_overflow }} cũ hơn</span>{% endif %}</h2>
    {% for p in pinned %}{{ pinned_item(p) }}{% endfor %}
  </section>
  {% endif %}

  {% if front_page.most_read %}
  <section class="most-read">
    <h2>Đọc nhiều</h2>
    <ol>
      {% for r in front_page.most_read %}
      <li><a href="#story-{{ r.item.id }}">{{ r.item.title }}</a></li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <div class="source-line">
    Nguồn:
    {% for source, count in front_page.source_counts.items() %}{{ source_names.get(source, source) }} {{ count }}{% if not loop.last %} · {% endif %}{% endfor %}
  </div>
</aside>
{% endmacro %}
