/* ===================== Newsroom tokens =====================
   Light newsprint is the default; Night edition is an explicit override via
   [data-theme="dark"]. No auto prefers-color-scheme switching. Offline: no
   external fonts/assets. One crimson accent; section colors are decorative
   ticks only and are never used for text. */

:root {
  /* paper & ink */
  --paper: #FBFAF7;
  --paper-warm: #F3F1EB;
  --ink: #1A1A1A;
  --ink-2: #4F4F4F;
  --ink-3: #6B6B6B;
  --rule: #E5E5E5;
  --rule-strong: #1A1A1A;
  --column-rule: #D8D4CA;

  /* brand */
  --red: #9F224E;
  --red-ink: #7A1839;
  --danger-ink: #B91C1C;
  --link: #1A4F8B;

  /* section identity — decorative ticks only */
  --sec-papers: #0F766E;
  --sec-news: #B45309;
  --sec-tools: #047857;
  --section-papers: var(--sec-papers);
  --section-news: var(--sec-news);
  --section-tools: var(--sec-tools);

  /* semantic aliases kept from the previous design system */
  --bg: var(--paper);
  --bg-raised: var(--paper);
  --bg-overlay: var(--paper-warm);
  --text-1: var(--ink);
  --text-2: var(--ink-2);
  --text-3: var(--ink-3);
  --accent: var(--red);
  --accent-strong: var(--red-ink);
  --accent-soft: rgba(159, 34, 78, 0.08);
  --border: var(--rule);
  --border-strong: var(--rule-strong);
  --danger: var(--danger-ink);
  --ring: var(--red);

  --card-radius: 2px;
  --card-gap: 24px;
  --shadow-1: none;
  --shadow-2: none;

  --font-serif: "Newsreader", Cambria, "Times New Roman", Georgia, serif;
  --font-sans: "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
  --font-mono: ui-monospace, "Cascadia Code", Consolas, monospace;

  --content-max: 1040px;
  --gutter: 24px;
  --radius-btn: 2px;
}

[data-theme="dark"] {
  --paper: #121212;
  --paper-warm: #1A1A1A;
  --ink: #F2EFE9;
  --ink-2: #C9C4BC;
  --ink-3: #9A958D;
  --rule: #3A3A3A;
  --rule-strong: #F2EFE9;
  --column-rule: #454545;
  --red: #FF6B6B;
  --red-ink: #FF9A9A;
  --danger-ink: #FF8A8A;
  --link: #8CC8FF;
  --accent-soft: rgba(255, 107, 107, 0.12);
  --sec-papers: #5EEAD4;
  --sec-news: #FCD34D;
  --sec-tools: #6EE7B7;
}

/* ===================== base ===================== */
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text-1);
       font: 15px/1.55 var(--font-sans); -webkit-font-smoothing: antialiased; }
.wrap { max-width: var(--content-max); margin: 0 auto; padding: 0 var(--gutter) 60px; }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; border-radius: 2px; }

/* ===================== masthead & dateline ===================== */
header.masthead { padding: 22px 0 0; border-top: 3px double var(--rule-strong); text-align: center; }
.masthead-top { display: flex; align-items: center; justify-content: space-between; gap: 12px;
                font: 700 10.5px/1.4 var(--font-sans); letter-spacing: 0.12em;
                text-transform: uppercase; color: var(--ink-3); }
.edition { display: inline-flex; align-items: center; gap: 6px; }
.masthead-actions { display: inline-flex; align-items: center; gap: 8px; }
.masthead-action { height: 26px; padding: 0 9px; font: 700 9.5px/1 var(--font-sans);
                   letter-spacing: 0.08em; text-transform: uppercase; }
.theme-toggle { width: 30px; height: 30px; border: 0; background: transparent;
                color: var(--ink-2); cursor: pointer; display: inline-flex;
                align-items: center; justify-content: center; }
.theme-toggle:hover { color: var(--red); }
h1 { margin: 0; font-family: var(--font-serif); font-weight: 700; }
.wordmark { margin: 8px 0 6px; font: 700 42px/1.02 var(--font-serif);
            letter-spacing: -0.03em; color: var(--ink); display: flex;
            align-items: center; justify-content: center; gap: 10px; }
.wordmark .stamp { display: inline-flex; align-items: center; justify-content: center;
                   width: 26px; height: 26px; background: var(--red); color: #fff;
                   font: 700 11px/1 var(--font-sans); letter-spacing: 0; }
.dateline { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px;
            padding: 7px 0 9px; border-bottom: 1px solid var(--rule);
            font: 500 10.5px/1.4 var(--font-sans); letter-spacing: 0.10em;
            text-transform: uppercase; color: var(--ink-3); }
.icon-sun { display: inline; }
.icon-moon { display: none; }
[data-theme="dark"] .icon-sun { display: none; }
[data-theme="dark"] .icon-moon { display: inline; }

/* ===================== section nav (sticky) ===================== */
.section-nav { position: sticky; top: 0; z-index: 30; display: flex; align-items: stretch;
               gap: 22px; height: 42px; background: var(--paper);
               border-bottom: 1px solid var(--rule); overflow-x: auto;
               scrollbar-width: none; }
.section-nav::-webkit-scrollbar { display: none; }
.section-nav a { flex: none; display: inline-flex; align-items: center;
                 font: 700 11px/1 var(--font-sans); letter-spacing: 0.08em;
                 text-transform: uppercase; color: var(--ink-2);
                 text-decoration: none; border-bottom: 2px solid transparent;
                 padding: 0 1px; }
.section-nav a:hover { color: var(--red); }
.section-nav a.active { color: var(--red); border-bottom-color: var(--red); }
@media (min-width: 760px) {
  .section-nav .pinned-link { display: none; }
}

/* ===================== status strips ===================== */
.status-strip { margin: 10px 0 0; padding: 8px 12px; border: 1px solid var(--rule);
                background: var(--paper-warm); font-size: 12.5px; line-height: 1.45; }
.status-strip.notice { color: var(--ink-2); }
.status-strip.degraded { border-color: color-mix(in srgb, var(--danger) 35%, transparent);
                         color: var(--danger); }
.status-strip code { font-family: var(--font-mono); font-size: 0.95em; }

/* ===================== briefing box ===================== */
.overview.briefing { margin: 22px 0 0; padding: 16px 18px; background: var(--paper-warm);
                     border-top: 3px solid var(--red); border-bottom: 1px solid var(--rule);
                     display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
                     gap: 18px 24px; }
.briefing-head { min-width: 0; }
.briefing .kicker { font: 700 10.5px/1.4 var(--font-sans); letter-spacing: 0.12em;
                    text-transform: uppercase; color: var(--red); }
.briefing-title { margin-top: 4px; font: 700 22px/1.15 var(--font-serif); color: var(--ink); }
.overview-points { counter-reset: brief; list-style: none; margin: 0; padding: 0;
                   display: grid; gap: 8px; }
.overview-point { display: flex; gap: 10px; color: var(--ink-2);
                  font: 14.5px/1.6 var(--font-sans); }
.overview-point::before { counter-increment: brief; content: counter(brief, decimal-leading-zero);
                          flex: none; width: 20px; color: var(--red); font-weight: 700;
                          font-size: 11px; line-height: 1.6; letter-spacing: 0.04em; }
.overview-point.spotlight { color: var(--ink); font-weight: 600; }
.overview-point.spotlight::before { content: "→"; width: auto; background: none;
                                    box-shadow: none; color: var(--red); font-weight: 700; }
.briefing .spark, .briefing .pill { display: none; }
@media (max-width: 760px) {
  .overview.briefing { grid-template-columns: 1fr; padding: 14px; }
}

/* ===================== top fold: hero + rail ===================== */
.top-fold { display: grid; grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr);
            gap: 24px; margin: 22px 0 30px; align-items: start; }
.hero { min-width: 0; }
.hero-col, .lead-col { min-width: 0; }
.kicker { margin: 0 0 8px; font: 700 10.5px/1.4 var(--font-sans);
          letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); }
.story { min-width: 0; }
.story-title { margin: 0; font: 700 38px/1.08 var(--font-serif);
               letter-spacing: -0.02em; }
.story-title a { color: var(--ink); text-decoration: none; }
.story-title a:hover { text-decoration: underline; text-underline-offset: 3px; }
.story-media { margin: 0 0 14px; }
.story-media img { width: 100%; aspect-ratio: 16 / 9; object-fit: contain;
                   background: var(--paper-warm); border: 1px solid var(--rule);
                   padding: 10px 14px; }
.story-media--og img { object-fit: cover; padding: 0; }
.story-media--portrait img { aspect-ratio: 3 / 4; }
.story--hero .story-media--portrait img { max-width: 460px; margin-inline: auto; }
.story-media figcaption { margin-top: 4px; font: 10.5px/1.4 var(--font-sans);
                         color: var(--ink-3); letter-spacing: 0.02em; }
[data-theme="dark"] .story-media img { background: #EAE6DD; filter: brightness(0.92); }
[data-theme="dark"] .story-media--og img { filter: none; }
.story--lead .story-title { font-size: 26px; }
.story--secondary { margin-top: 22px; padding-top: 16px; border-top: 1px solid var(--rule); }
.story--secondary .story-title { font-size: 24px; }
.story--secondary .why { font-size: 15px; }
.story--brief .story-title, .story--more .story-title { font-size: 17px; line-height: 1.3; }
.story--pinned .story-title { font-size: 15.5px; line-height: 1.35; }
.why { margin: 9px 0 0; color: var(--ink-2); font: 16px/1.5 var(--font-serif); }
.story--hero .why { font-size: 17px; }
.summary { margin: 8px 0 0; color: var(--ink-2); font: 14.5px/1.55 var(--font-sans);
           display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical;
           overflow: hidden; }
.story--hero .summary { -webkit-line-clamp: 10; }
.story--lead .summary { -webkit-line-clamp: 6; }
.story--secondary .summary { -webkit-line-clamp: 4; }
.summary.ai::before { content: "AI SUMMARY"; display: block; font: 700 9px/1.4 var(--font-sans);
                      letter-spacing: 0.12em; color: var(--red); margin-bottom: 3px; }
.meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; margin-top: 10px;
        color: var(--ink-3); font: 500 12px/1.4 var(--font-sans); }
.meta span + span::before { content: "·"; margin-right: 8px; color: var(--rule-strong); }
.tag-new { color: var(--red); font-weight: 700; letter-spacing: 0.06em; }
.tag-new::before { content: none !important; }
.story .actions { margin-top: 10px; }
.story .ask { margin-top: 8px; }

/* ===================== rail ===================== */
.rail { display: grid; gap: 16px; min-width: 0; align-self: stretch; }
.rail .overview.briefing { grid-template-columns: 1fr; gap: 10px; margin: 0; padding: 14px 16px; }
.rail .briefing-title { font-size: 20px; }
.rail .overview-point { font-size: 13.5px; }
.rail .overview-point::before { font-size: 10px; }
.rail .pinned-block { margin: 0; padding-top: 10px; border-top: 3px solid var(--red); }
.rail .pinned-block h2 { display: flex; align-items: baseline; gap: 8px; margin: 0 0 6px;
                        font: 700 11px/1.4 var(--font-sans); letter-spacing: 0.12em;
                        text-transform: uppercase; color: var(--ink-2); }
.rail .pinned-block .pill { background: var(--paper-warm); border: 1px solid var(--rule);
                            border-radius: 999px; padding: 0 7px; font-size: 10px;
                            letter-spacing: 0; color: var(--ink-3); }
.rail .pinned-block .story { padding: 9px 0; border-top: 1px solid var(--rule); }
.rail .pinned-block .story-title { font-size: 15.5px; }
.most-read { padding-top: 10px; border-top: 1px solid var(--rule); }
.hero-col .most-read { margin-top: 22px; }
.most-read h2 { margin: 0 0 4px; font: 700 11px/1.4 var(--font-sans); letter-spacing: 0.12em;
                text-transform: uppercase; color: var(--ink-2); }
.most-read ol { counter-reset: most; margin: 0; padding: 0; list-style: none; }
.most-read li { counter-increment: most; display: flex; gap: 10px; padding: 8px 0;
                border-bottom: 1px solid var(--rule); }
.most-read li::before { content: counter(most, decimal-leading-zero); flex: none;
                        font: 700 18px/1.2 var(--font-serif); color: var(--rule-strong);
                        opacity: 0.35; }
.most-read a { font: 600 15px/1.35 var(--font-serif); color: var(--ink); text-decoration: none;
               display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
               overflow: hidden; }
.most-read a:hover { text-decoration: underline; text-underline-offset: 3px; }
.source-line { color: var(--ink-3); font: 11px/1.4 var(--font-sans); letter-spacing: 0.04em; }

/* ===================== section fronts ===================== */
.section-front { margin: 34px 0 0; }
.sec-papers { --section-color: var(--section-papers); }
.sec-tech_news { --section-color: var(--section-news); }
.sec-tools_releases { --section-color: var(--section-tools); }
.section-head { display: flex; align-items: baseline; gap: 10px; border-top: 1px solid var(--rule);
                border-left: 2px solid var(--section-color, var(--red));
                padding: 10px 0 0 10px; margin-bottom: 12px; }
.section-head .idx { font: 700 18px/1 var(--font-serif); color: var(--red); }
.section-head h2 { display: inline-block; margin: 0; padding-bottom: 4px;
                   border-bottom: 3px solid var(--red); font: 700 22px/1.2 var(--font-serif); }
.section-head .count { margin-left: auto; color: var(--ink-3); font: 500 11px/1.4 var(--font-sans);
                       letter-spacing: 0.08em; text-transform: uppercase; }
.section-body { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
                gap: 28px; align-items: start; }
.section-front--band .section-body { display: block; }
.section-front--band .story--lead .story-title { font-size: 28px; }
.briefs { display: grid; gap: 0; align-content: start; }
.story--brief { padding: 11px 0; border-top: 1px solid var(--rule); }
.story--brief:first-child { border-top: 0; padding-top: 0; }
.story--lead { padding: 0; }
.section-front--grid .briefs { grid-template-columns: 1fr; }
.more-list { margin-top: 8px; padding-top: 6px; border-top: 1px solid var(--rule); }
.more-list .story { padding: 7px 0; border-top: 1px solid var(--rule); }
.more-list .story:first-child { border-top: 0; }
.empty-note, .section-note { margin: 0; padding: 12px 0; border-top: 1px solid var(--rule);
                             color: var(--ink-3); font: 13px/1.5 var(--font-sans); }
.section-note a { color: var(--red); text-decoration: none; }
.section-note a:hover { text-decoration: underline; }

@media (min-width: 1100px) {
  .section-front--grid .briefs { grid-template-columns: 1fr 1fr; column-gap: 20px; }
  .section-front--grid .briefs .story--brief:nth-child(1),
  .section-front--grid .briefs .story--brief:nth-child(2) { border-top: 0; padding-top: 0; }
  .section-front--grid .briefs .story--brief:nth-child(n+3) { border-top: 1px solid var(--rule); padding-top: 11px; }
}

@media (min-width: 920px) {
  .rail { border-left: 1px solid var(--column-rule); padding-left: 18px; }
  .section-body .briefs { border-left: 1px solid var(--column-rule); padding-left: 18px; }
  .section-front--split:nth-of-type(even) .briefs,
  .section-front--grid:nth-of-type(even) .briefs {
    border-left: 0;
    border-right: 1px solid var(--column-rule);
    padding-left: 0;
    padding-right: 18px;
  }
}

/* alternating section fronts (reset when stacked) */
.section-front--split:nth-of-type(even) .section-body,
.section-front--grid:nth-of-type(even) .section-body {
  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
}
.section-front--split:nth-of-type(even) .lead-col,
.section-front--grid:nth-of-type(even) .lead-col { grid-column: 2; grid-row: 1; }
.section-front--split:nth-of-type(even) .briefs,
.section-front--grid:nth-of-type(even) .briefs { grid-column: 1; grid-row: 1; }

/* responsive */
@media (max-width: 920px) {
  .top-fold { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .wordmark { font-size: 32px; }
  .story-title { font-size: 32px; }
  .story--lead .story-title { font-size: 23px; }
  .section-body, .section-front--split:nth-of-type(even) .section-body,
  .section-front--grid:nth-of-type(even) .section-body { grid-template-columns: 1fr; }
  .section-front--split:nth-of-type(even) .lead-col,
  .section-front--grid:nth-of-type(even) .lead-col,
  .section-front--split:nth-of-type(even) .briefs,
  .section-front--grid:nth-of-type(even) .briefs { grid-column: auto; grid-row: auto; }
  .section-front--grid .briefs { grid-template-columns: 1fr; }
  .section-head h2 { font-size: 20px; }
  .section-head .count { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .dots span { animation: none; }
}

/* ===================== saved-articles modal ===================== */
.saved-modal[hidden] { display: none; }
.saved-modal { position: fixed; inset: 0; z-index: 100; display: flex;
               align-items: center; justify-content: center; padding: 18px;
               background: rgba(20, 18, 15, 0.55); }
.saved-modal__panel { width: min(680px, 100%); max-height: min(84vh, 900px);
                      overflow: auto; background: var(--paper); color: var(--ink);
                      border-top: 3px solid var(--red); padding: 18px 20px 22px; }
.saved-modal__head { display: flex; align-items: center; justify-content: space-between;
                     gap: 12px; border-bottom: 1px solid var(--rule); padding-bottom: 10px; }
.saved-modal__head h2 { margin: 0; font: 700 24px/1.2 var(--font-serif); }
.saved-card { padding: 14px 0; border-top: 1px solid var(--rule); }
.saved-card:first-child { border-top: 0; }
.saved-card h3 { margin: 0; font: 700 18px/1.25 var(--font-serif); }
.saved-card h3 a { color: var(--ink); text-decoration: none; }
.saved-card h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
.saved-card .summary { margin: 6px 0 10px; font-size: 13.5px; }
.saved-card button { margin-top: 8px; }

/* ===================== bridge-only UI (feedback buttons, ask drawer) =====================
     Hidden by default; revealed ONLY when the pywebview api really exists. */
  .bridge-only { display: none; }
  body.bridged .bridge-only { display: inline-flex; }
  .actions { margin-top: 12px; gap: 8px; }
  .act { display: inline-flex; align-items: center; justify-content: center; gap: 6px;
         min-width: 32px; height: 32px; padding: 0 8px;
         border: 1px solid var(--border); background: var(--bg-overlay); color: var(--text-2);
         border-radius: 2px; font-size: 12.5px; cursor: pointer; transition: all 0.18s ease; }
  .act:hover { border-color: var(--accent); color: var(--accent-strong); transform: translateY(-1px); }
  .act:disabled { opacity: 0.55; cursor: default; transform: none; }
  .act.done { background: var(--accent); border-color: var(--accent); color: #ffffff;
              font-weight: 600; }
  .act.done .icon { stroke: #ffffff; }
  .act.failed { border-color: var(--danger); color: var(--danger); }
  .icon { width: 17px; height: 17px; stroke: currentColor; fill: none;
          stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .icon-sm { width: 15px; height: 15px; stroke: currentColor; fill: none;
             stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ask { display: none; margin-top: 8px; border-top: 1px dashed var(--rule); padding-top: 7px; }
  body.bridged .ask { display: block; }
  .ask summary { cursor: pointer; list-style: none; font: 600 12px/1.4 var(--font-sans);
                 color: var(--red); }
  .ask summary::-webkit-details-marker { display: none; }
  .ask summary::before { content: "+ "; }
  .ask[open] summary::before { content: "− "; }
  .ask-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
  .ask-input { flex: 1 1 55%; min-width: 0; border: 1px solid var(--border-strong); border-radius: 2px;
               padding: 8px 12px; font: 13.5px/1.4 var(--font-sans); background: var(--bg); color: var(--text-1); }
  .ask-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .ask-btn { margin-top: 0; flex: none; }
  .ask-answer { flex: 1 0 100%; margin-top: 6px; font-size: 13.5px; color: var(--text-2);
                white-space: pre-wrap; display: none;
                background: var(--bg-overlay); border: 1px solid var(--border); border-radius: 3px;
                padding: 10px 12px; }
  .ask-answer:not(:empty) { display: block; }
  .dots { display: inline-flex; gap: 4px; padding: 3px 0; }
  .dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
               animation: blink 1.2s infinite ease-in-out; }
  .dots span:nth-child(2) { animation-delay: 0.18s; }
  .dots span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes blink { 0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
                     40% { opacity: 1; transform: translateY(-3px); } }

  footer { margin-top: 40px; color: var(--text-3); font-size: 12.5px; border-top: 1px solid var(--border);
           padding-top: 14px; }
  footer code { background: var(--bg-overlay); border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; }

  .empty { border: 1px dashed var(--border-strong); border-radius: var(--card-radius);
           padding: 18px; color: var(--text-3); font-size: 13px; text-align: center; }

  /* ===================== print: a two-column broadsheet ===================== */
  @page { size: A4; margin: 16mm; }

  @media print {
    :root, [data-theme="light"], [data-theme="dark"] {
      --paper: #FFFFFF; --paper-warm: #FFFFFF;
      --ink: #111111; --ink-2: #333333; --ink-3: #555555;
      --rule: #BBBBBB; --rule-strong: #111111;
      --red: #111111; --red-ink: #111111; --danger-ink: #111111; --link: #111111;
      --accent: #111111; --accent-strong: #111111; --accent-soft: transparent;
      --border: #BBBBBB; --border-strong: #111111;
      --bg: #FFFFFF; --bg-raised: #FFFFFF; --bg-overlay: #FFFFFF;
      --text-1: #111111; --text-2: #333333; --text-3: #555555;
      --shadow-1: none; --shadow-2: none;
    }
    body { background: #FFFFFF; color: #111111; font-size: 9.5pt; line-height: 1.35; }
    .wrap { max-width: 100%; padding: 0; }
    .section-nav, .theme-toggle, .bridge-only, .ask, .actions, footer,
    .saved-modal,
    .most-read, .source-line, .story-media { display: none !important; }
    header.masthead { border-top: 3px double #111; padding: 0 0 4mm; text-align: center; }
    .wordmark { font-size: 24pt; }
    .dateline { border-bottom: 1px solid #999; font-size: 7pt; }
    .top-fold { display: block; margin: 4mm 0 0; }
    .rail { border-left: 0; }
    .rail .overview.briefing { display: block; border-top: 2px solid #111;
                               border-bottom: 1px solid #999; padding: 3mm 0; margin: 3mm 0; }
    .rail .pinned-block { border-top: 1px solid #111; margin-top: 3mm; }
    .story { break-inside: avoid; }
    .story-title { color: #111; font-size: 13pt; }
    .story--lead .story-title, .story--secondary .story-title { font-size: 12pt; }
    .story--brief .story-title, .story--more .story-title { font-size: 9.5pt; }
    .summary { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
               overflow: hidden; color: #333; font-size: 8.5pt; line-height: 1.35; }
    .story--hero .summary { -webkit-line-clamp: 5; }
    .story--lead .summary, .story--secondary .summary { -webkit-line-clamp: 4; }
    .why { color: #333; font-size: 8.5pt; line-height: 1.3; }
    .meta { color: #555; border-top: 1px solid #ddd; padding-top: 1mm; font-size: 7.5pt; }
    .section-front { margin-top: 5mm; break-inside: auto; }
    .section-head { border-top: 1px solid #111; border-left: 0; padding-left: 0;
                    break-after: avoid; }
    .section-head h2 { border-bottom-color: #111; font-size: 13pt; }
    .section-head .count { color: #555; }
    .section-body { display: block; }
    .section-body .briefs { border-left: 0; border-right: 0; }
    .briefs { column-count: 2; column-gap: 6mm; }
    .more-list { column-count: 1; }
    .story--brief { break-inside: avoid; border-top: 1px solid #ccc; padding: 2mm 0; }
    .story--brief:first-child { border-top: 0; padding-top: 0; }
    .empty-note, .section-note { border-top: 1px solid #999; color: #555; }
    a { color: #111; text-decoration: none; }
  }
