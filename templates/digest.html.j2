<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily AI Digest — {{ date }}</title>
<style>
{% include "newsroom.css.j2" %}
</style>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <defs>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/></symbol>
    <symbol id="i-thumb-up" viewBox="0 0 24 24"><path d="M7 11v9M7 11l4-7c.6-1 2-1.2 2.8-.4.4.4.6 1 .5 1.5L13.5 9H18a2 2 0 0 1 2 2.3l-1.2 6A2 2 0 0 1 16.8 19H7M7 11H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/></symbol>
    <symbol id="i-thumb-down" viewBox="0 0 24 24"><path d="M7 13V4M7 13l4 7c.6 1 2 1.2 2.8.4.4-.4.6-1 .5-1.5L13.5 15H18a2 2 0 0 0 2-2.3l-1.2-6A2 2 0 0 0 16.8 5H7M7 13H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h2"/></symbol>
    <symbol id="i-bookmark" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 17v5M9 3h6l1 7 2 2H6l2-2 1-7z"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/></symbol>
  </defs>
</svg>
<div class="wrap">
  <header>
    <button id="theme-toggle" class="theme-toggle" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
      <svg class="icon icon-moon" aria-hidden="true"><use href="#i-moon"/></svg>
      <svg class="icon icon-sun" aria-hidden="true"><use href="#i-sun"/></svg>
    </button>
    <h1>Daily AI Digest</h1>
    <div class="date">{{ date }} · {{ total }} items picked for you</div>
    <div class="badges">
      <span class="badge">ranked by {% if mode == "llm" %}{{ model_name }}{% elif mode == "empty" %}empty digest (muted){% else %}heuristic (LLM offline){% endif %}</span>
      {% if counts.papers %}<span class="badge">{{ counts.papers }} papers</span>{% endif %}
      {% if counts.tech_news %}<span class="badge">{{ counts.tech_news }} tech news</span>{% endif %}
      {% if counts.tools_releases %}<span class="badge">{{ counts.tools_releases }} tools</span>{% endif %}
    </div>
    {% if notice %}
    <div class="notice">{{ notice }}</div>
    {% endif %}
    {% if degraded %}
    <div class="degraded">
      This digest ran in degraded mode{% if sources_failed %} — source(s) unavailable: {{ sources_failed | join(", ") }}{% endif %}.
      Details in <code>logs/daily-digest.log</code>.
    </div>
    {% endif %}

    {% if overview %}
    <section class="overview">
      <h2><svg class="icon-sm spark" aria-hidden="true"><use href="#i-spark"/></svg>{{ overview_label }} <span class="pill">TL;DR</span></h2>
      <ul class="overview-points">
        {% for point in overview.split(". ")[:4] %}
        <li class="overview-point{% if loop.last and loop.length > 1 %} spotlight{% endif %}">{{ point }}{% if not loop.last and not point.endswith(".") %}.{% endif %}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </header>

  {% if pinned %}
  <section class="block pinned-block">
    <h2><svg class="icon-sm" style="color: var(--section-news)" aria-hidden="true"><use href="#i-pin"/></svg> Nhìn lại <span class="pill">{{ pinned | length }}</span>{% if pinned_overflow %} <span class="pill">+{{ pinned_overflow }} mục đã lưu cũ hơn</span>{% endif %}</h2>
    {% for p in pinned %}
    <article class="card" data-uid="{{ p.uid }}">
      <a class="title" href="{{ p.url | safe_href }}" target="_blank" rel="noopener noreferrer">{{ p.title }}</a>
      <div class="meta">
        <span class="src {{ 'papers' if p.source != 'hn' else 'hn' }}">{{ source_names.get(p.source, p.source) }}</span>
        {% if p.points %}<span class="chip">{{ p.points }} points</span>{% endif %}
        {% if p.citations %}<span class="chip">{{ p.citations }} citations</span>{% endif %}
      </div>
      {% if p.why %}<p class="why">{{ p.why }}</p>{% endif %}
      {% set p_summary = p.llm_summary or p.summary %}
      {% if p_summary %}<p class="summary{% if p.llm_summary %} ai{% endif %}">{{ p_summary }}</p>{% endif %}
      <div class="actions bridge-only">
        <button class="act" data-feedback="{{ p.uid }}|unsave" title="Đọc xong, bỏ khỏi Nhìn lại" aria-label="Đọc xong, bỏ khỏi Nhìn lại"><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg><span>Đọc xong</span></button>
      </div>
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% for section_key, section_items in sections.items() %}
    <section class="block sec-{{ section_key }}">
      <h2><span class="idx">{{ "%02d" | format(loop.index) }}</span>{{ section_titles[section_key] }} <span class="pill">{{ section_items | length }}</span></h2>
      {% for r in section_items %}
      <article class="card" data-uid="{{ r.item.id }}" style="--i: {{ loop.index0 }}">
        <a class="title" href="{{ r.item.url | safe_href }}" target="_blank" rel="noopener noreferrer">{{ r.item.title }}</a>
        <div class="meta">
          <span class="src {{ 'papers' if r.item.source != 'hn' else 'hn' }}">{{ source_names[r.item.source] }}</span>
          {% if r.item.points %}<span class="chip">{{ r.item.points }} points</span>{% endif %}
          {% if r.item.citations %}<span class="chip">{{ r.item.citations }} citations</span>{% endif %}
          {% if r.item.source == 'arxiv' %}<span class="chip">new today</span>{% endif %}
        </div>
        <p class="why">{{ r.why }}</p>
        {% set summary_text = r.llm_summary or r.item.summary %}
        {% if summary_text %}
        <p class="summary{% if r.llm_summary %} ai{% endif %}">{{ summary_text }}</p>
        {% endif %}
        <div class="actions bridge-only">
          <button class="act" data-feedback="{{ r.item.id }}|like" title="Digest này nên có nhiều bài thế này hơn" aria-label="Thích mục này"><svg class="icon" aria-hidden="true"><use href="#i-thumb-up"/></svg></button>
          <button class="act" data-feedback="{{ r.item.id }}|dislike" title="Bớt loại này ra" aria-label="Không thích mục này"><svg class="icon" aria-hidden="true"><use href="#i-thumb-down"/></svg></button>
          <button class="act" data-feedback="{{ r.item.id }}|save" title="Giữ lại trong mục Nhìn lại" aria-label="Lưu mục này vào Nhìn lại"><svg class="icon" aria-hidden="true"><use href="#i-bookmark"/></svg><span>Lưu</span></button>
        </div>
        <div class="ask">
          <input class="ask-input" type="text" placeholder="Hỏi thêm về mục này… (Ctrl+Enter)" aria-label="Nhập câu hỏi về mục này">
          <button class="act ask-btn" data-ask="1" aria-label="Hỏi về mục này"><svg class="icon" aria-hidden="true"><use href="#i-send"/></svg>Hỏi</button>
          <div class="ask-answer" aria-live="polite"></div>
        </div>
      </article>
      {% endfor %}
      {% if not section_items %}
      <div class="empty">— hôm nay không có mục nào trong nhóm này —</div>
      {% endif %}
    </section>
  {% endfor %}

  <footer>
    Generated by daily-digest · to change the ranking model edit <code>llm.model</code> in
    <code>config.yaml</code> (e.g. glm-5.3-flash, glm-5.3, deepseek-v4.1-flash) ·
    old digests are archived in <code>output/</code>
  </footer>
</div>
{% if digest_data %}
<script type="application/json" id="digest-data">{{ digest_data | tojson }}</script>
{% endif %}
<script>
  (function () {
    /* --- theme: default follows the system; toggle persists in localStorage --- */
    var KEY = "digest-theme";
    function applyTheme(t) {
      if (t === "light" || t === "dark") {
        document.documentElement.setAttribute("data-theme", t);
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
    }
    try { applyTheme(localStorage.getItem(KEY)); } catch (e) { /* storage unavailable: system default */ }
    var toggle = document.getElementById("theme-toggle");
    if (toggle) {
      toggle.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-theme");
        var systemDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        var effective = current || (systemDark ? "dark" : "light");
        var next = effective === "dark" ? "light" : "dark";
        applyTheme(next);
        try { localStorage.setItem(KEY, next); } catch (e2) { /* per-session only */ }
      });
    }

    /* --- pywebview bridge: revealed only when the api really exists --- */
    function ready() {
      if (typeof window.pywebview !== "undefined" &&
          typeof window.pywebview.api !== "undefined" &&
          typeof window.pywebview.api.feedback === "function") {
        document.body.classList.add("bridged");
      }
    }
    window.addEventListener("pywebviewready", ready);

    document.addEventListener("click", function (ev) {
      var btn = ev.target.closest("[data-feedback]");
      if (!btn || !document.body.classList.contains("bridged")) return;
      var parts = btn.getAttribute("data-feedback").split("|");
      btn.classList.remove("done", "failed");
      pywebview.api.feedback(parts[0], parts[1]).then(function (res) {
        if (res && res.ok) { btn.classList.add("done"); }
        else { btn.classList.add("failed"); }
      }).catch(function () { btn.classList.add("failed"); });
    });

    function sendAsk(card) {
      var uid = card.getAttribute("data-uid");
      var input = card.querySelector(".ask-input");
      var out = card.querySelector(".ask-answer");
      var btn = card.querySelector(".ask-btn");
      var q = (input.value || "").trim();
      if (!q || btn.disabled) return;
      out.innerHTML = '<span class="dots"><span></span><span></span><span></span></span>';
      btn.disabled = true;
      pywebview.api.ask(uid, q).then(function (answer) {
        out.textContent = answer || "(không có câu trả lời)";
        btn.disabled = false;
      }).catch(function (err) {
        out.textContent = "Lỗi: " + err;
        btn.disabled = false;
      });
    }

    document.addEventListener("click", function (ev) {
      var btn = ev.target.closest("[data-ask]");
      if (!btn || !document.body.classList.contains("bridged")) return;
      sendAsk(btn.closest("[data-uid]"));
    });

    document.addEventListener("keydown", function (ev) {
      if (ev.key !== "Enter" || !ev.ctrlKey) return;
      if (!document.body.classList.contains("bridged")) return;
      var input = ev.target.closest ? ev.target.closest(".ask-input") : null;
      if (input) { ev.preventDefault(); sendAsk(input.closest("[data-uid]")); }
    });
  })();
</script>
</body>
</html>
