<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily AI Digest — {{ date }}</title>
<style>
{% include "newsroom.css.j2" %}
</style>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <defs>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/></symbol>
    <symbol id="i-thumb-up" viewBox="0 0 24 24"><path d="M7 11v9M7 11l4-7c.6-1 2-1.2 2.8-.4.4.4.6 1 .5 1.5L13.5 9H18a2 2 0 0 1 2 2.3l-1.2 6A2 2 0 0 1 16.8 19H7M7 11H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/></symbol>
    <symbol id="i-thumb-down" viewBox="0 0 24 24"><path d="M7 13V4M7 13l4 7c.6 1 2 1.2 2.8.4.4-.4.6-1 .5-1.5L13.5 15H18a2 2 0 0 0 2-2.3l-1.2-6A2 2 0 0 0 16.8 5H7M7 13H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h2"/></symbol>
    <symbol id="i-bookmark" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 17v5M9 3h6l1 7 2 2H6l2-2 1-7z"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/></symbol>
  </defs>
</svg>
<div class="wrap">
  <header class="masthead" id="top">
    <div class="masthead-top">
      <span class="edition">BẢN TIN AI</span>
      <div class="masthead-actions">
        <button class="act bridge-only masthead-action" id="saved-open" type="button" title="Xem tất cả bài đã lưu">Đã lưu</button>
        <button class="act bridge-only masthead-action" id="refresh-now" type="button" title="Tìm các bài mới chưa từng hiển thị">Tìm bài mới</button>
        <button id="theme-toggle" class="theme-toggle" aria-label="Đổi giao diện sáng/tối" title="Đổi giao diện sáng/tối">
          <svg class="icon icon-moon" aria-hidden="true"><use href="#i-moon"/></svg>
          <svg class="icon icon-sun" aria-hidden="true"><use href="#i-sun"/></svg>
        </button>
      </div>
    </div>
    <h1 class="wordmark"><span class="stamp">AI</span>Daily AI Digest</h1>
    <div class="dateline">
      <span>{{ date_long or date }} · {{ total }} câu chuyện</span>
      <span>Biên tập: {% if mode == "llm" %}{{ model_name }}{% elif mode == "empty" %}empty digest{% else %}heuristic{% endif %}</span>
    </div>
  </header>

  <nav class="section-nav" aria-label="Chuyên mục">
    <a href="#top" class="active">Tổng hợp</a>
    <a href="#papers">Nghiên cứu</a>
    <a href="#tech-news">Công nghệ</a>
    <a href="#tools-releases">Công cụ</a>
    {% if pinned %}<a href="#pinned" class="pinned-link">Nhìn lại</a>{% endif %}
  </nav>

  {% if notice %}
  <div class="status-strip notice">{{ notice }}</div>
  {% endif %}
  {% if degraded %}
  <div class="status-strip degraded">
    This digest ran in degraded mode{% if sources_failed %} — source(s) unavailable: {{ sources_failed | join(", ") }}{% endif %}.
    Details in <code>logs/daily-digest.log</code>.
  </div>
  {% endif %}

  {% from "partials/_story.html.j2" import story, pinned_item, rail, most_read with context %}

  {% if front_page.lead %}
  <div class="top-fold">
    <div class="hero-col">
      {{ story(front_page.lead, "hero") }}
      {% if front_page.secondary %}{{ story(front_page.secondary, "secondary") }}{% endif %}
      {{ most_read() }}
    </div>
    {{ rail() }}
  </div>
  {% else %}
  <div class="top-fold top-fold--empty">
    <div class="empty-note">— hôm nay không có mục nào —</div>
    {{ rail() }}
  </div>
  {% endif %}

  {% for section in front_page.sections %}
  {% set section_key = section.key %}
  {% set shown = (1 if section.lead else 0) + (section.briefs | length) %}
  {% set section_variant = "empty" if section.total == 0 else ("hero-only" if section.lead is none else ("band" if section.briefs | length == 0 else ("split" if section.briefs | length <= 3 else "grid"))) %}
  <section class="section-front sec-{{ section_key }} section-front--{{ section_variant }}" id="{{ section_key | replace('_', '-') }}">
    <div class="section-head">
      <span class="idx">{{ "%02d" | format(loop.index) }}</span>
      <h2>{{ section.title }}</h2>
      <span class="count">{{ section.total }} stories{% if section.total > shown %} · {{ section.total - shown }} ở trên{% endif %}</span>
    </div>

    {% if section.total == 0 %}
    <p class="empty-note">— hôm nay không có mục nào trong nhóm này —</p>
    {% elif section.lead is none %}
    <p class="section-note">Bài chính ở trên.</p>
    {% else %}
    <div class="section-body">
      <div class="lead-col">
        {{ story(section.lead, "lead") }}
        {% if section.briefs | length > 6 %}
        <div class="more-list">
          {% for r in section.briefs[6:] %}{{ story(r, "more") }}{% endfor %}
        </div>
        {% endif %}
      </div>
      {% if section.briefs %}
      <div class="briefs">
        {% for r in section.briefs[:6] %}{{ story(r, "brief") }}{% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </section>
  {% endfor %}

  <footer>
    Generated by daily-digest · to change the ranking model edit <code>llm.model</code> in
    <code>config.yaml</code> (e.g. glm-5.3-flash, glm-5.3, deepseek-v4.1-flash) ·
    old digests are archived in <code>output/</code>
  </footer>
</div>

<div id="saved-modal" class="saved-modal" role="dialog" aria-modal="true" aria-labelledby="saved-title" hidden>
  <div class="saved-modal__panel">
    <div class="saved-modal__head">
      <h2 id="saved-title">Đã lưu</h2>
      <button id="saved-close" class="act" type="button" aria-label="Đóng">×</button>
    </div>
    <div id="saved-list" class="saved-list"></div>
    <p id="saved-empty" class="empty-note" hidden>Chưa có bài nào được lưu.</p>
  </div>
</div>

<div id="undo-bar" class="undo-bar" role="status" aria-live="polite" hidden>
  <span id="undo-text">Đã bỏ lưu.</span>
  <button id="undo-btn" class="act" type="button">Hoàn tác</button>
</div>

{% if digest_data %}
<script type="application/json" id="digest-data">{{ digest_data | tojson }}</script>
{% endif %}
<script>
  (function () {
    /* --- theme: default follows the system; toggle persists in localStorage --- */
    var KEY = "digest-theme";
    function applyTheme(t) {
      if (t === "light" || t === "dark") {
        document.documentElement.setAttribute("data-theme", t);
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
    }
    try { applyTheme(localStorage.getItem(KEY)); } catch (e) { /* storage unavailable: system default */ }
    var toggle = document.getElementById("theme-toggle");
    if (toggle) {
      toggle.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-theme");
        var effective = current || "light";
        var next = effective === "dark" ? "light" : "dark";
        applyTheme(next);
        try { localStorage.setItem(KEY, next); } catch (e2) { /* per-session only */ }
      });
    }

    /* --- pywebview bridge: revealed only when the api really exists --- */
    function setRating(button, action) {
      var card = button.closest("[data-uid]");
      if (!card) return;
      card.querySelectorAll('[data-feedback$="|like"], [data-feedback$="|dislike"]')
        .forEach(function (b) {
          b.classList.remove("active");
          b.removeAttribute("data-rating");
        });
      if (action === "like" || action === "dislike") {
        var active = card.querySelector('[data-feedback$="|' + action + '"]');
        if (active) {
          active.classList.add("active");
          active.setAttribute("data-rating", action);
        }
      }
    }

    function applyRatings() {
      if (!document.body.classList.contains("bridged") ||
          !window.pywebview.api.ratings) return;
      pywebview.api.ratings().then(function (res) {
        if (!res || !res.ok) return;
        var ratings = res.ratings || {};
        document.querySelectorAll("[data-uid]").forEach(function (card) {
          var rating = ratings[card.getAttribute("data-uid")];
          if (!rating) return;
          var button = card.querySelector('[data-feedback$="|' + rating + '"]');
          if (button) {
            button.classList.add("active");
            button.setAttribute("data-rating", rating);
          }
        });
      }).catch(function () { /* ratings are decorative */ });
    }

    function setSaved(button, saved) {
      button.classList.toggle("active", saved);
      button.setAttribute("data-saved", saved ? "1" : "0");
      var label = button.querySelector("span");
      if (label) label.textContent = saved ? "Đã lưu" : "Lưu";
      var text = saved ? "Bỏ lưu mục này" : "Giữ lại trong mục Nhìn lại";
      button.title = text;
      button.setAttribute("aria-label", text);
    }

    function setSavedByUid(uid, saved) {
      document.querySelectorAll('[data-feedback="' + uid + '|save"]')
        .forEach(function (button) { setSaved(button, saved); });
    }

    function applySaved() {
      if (!document.body.classList.contains("bridged") ||
          !window.pywebview.api.saved_items) return;
      pywebview.api.saved_items().then(function (res) {
        if (!res || !res.ok) return;
        var saved = {};
        (res.items || []).forEach(function (item) {
          if (item.uid) saved[item.uid] = true;
        });
        document.querySelectorAll('[data-feedback$="|save"]').forEach(function (button) {
          var uid = button.getAttribute("data-feedback").split("|")[0];
          setSaved(button, !!saved[uid]);
        });
      }).catch(function () { /* default labels stay Lưu */ });
    }

    function ready() {
      if (typeof window.pywebview !== "undefined" &&
          typeof window.pywebview.api !== "undefined" &&
          typeof window.pywebview.api.feedback === "function") {
        document.body.classList.add("bridged");
        applyRatings();
        applySaved();
      }
    }
    window.addEventListener("pywebviewready", ready);

    document.addEventListener("click", function (ev) {
      var btn = ev.target.closest("[data-feedback]");
      if (!btn || !document.body.classList.contains("bridged")) return;
      var parts = btn.getAttribute("data-feedback").split("|");
      var action = parts[1];
      var isSave = action === "save";
      var isRating = action === "like" || action === "dislike";
      if (isRating) {
        var current = btn.getAttribute("data-rating") ||
          (btn.classList.contains("active") ? action : "");
        if (current === action) {
          action = action === "like" ? "unlike" : "undislike";
        }
      }
      btn.classList.remove("done", "failed");
      var request = isSave
        ? pywebview.api.toggle_save(parts[0])
        : pywebview.api.feedback(parts[0], action);
      request.then(function (res) {
        if (res && res.ok) {
          if (isSave) {
            setSavedByUid(parts[0], !!res.saved);  /* Lưu <-> Đã lưu, one button */
          } else if (isRating) {
            setRating(btn, action);
          } else {
            btn.classList.add("done");
          }
          if (!isSave && action === "unsave") {
            setSavedByUid(parts[0], false);
            var savedCard = btn.closest(".saved-card");
            if (savedCard) savedCard.remove();  /* modal is live; rail stays static */
            showUndo(parts[0]);
          }
        }
        else { btn.classList.add("failed"); }
      }).catch(function () { btn.classList.add("failed"); });
    });

    /* --- saved articles modal: all saves, read live from the bridge --- */
    var savedModal = document.getElementById("saved-modal");
    var savedList = document.getElementById("saved-list");
    var savedEmpty = document.getElementById("saved-empty");

    function closeSaved() {
      if (savedModal) savedModal.hidden = true;
    }

    function savedCard(item) {
      var card = document.createElement("article");
      card.className = "saved-card";
      var link = document.createElement("a");
      link.href = item.href || "#";
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = item.title || "(không có tiêu đề)";
      var heading = document.createElement("h3");
      heading.appendChild(link);
      card.appendChild(heading);

      var meta = document.createElement("div");
      meta.className = "meta";
      var bits = [item.source_label || item.source || "", "", ""];
      if (item.points) bits[1] = item.points + " points";
      if (item.citations) bits[2] = item.citations + " citations";
      bits.forEach(function (text) {
        if (!text) return;
        var span = document.createElement("span");
        span.textContent = text;
        meta.appendChild(span);
      });
      card.appendChild(meta);

      var summary = item.llm_summary || item.summary || "";
      if (summary) {
        var p = document.createElement("p");
        p.className = "summary";
        p.textContent = summary;
        card.appendChild(p);
      }

      var unsave = document.createElement("button");
      unsave.type = "button";
      unsave.className = "act";
      unsave.textContent = "Đọc xong";
      unsave.setAttribute("data-feedback", (item.uid || "") + "|unsave");
      card.appendChild(unsave);
      return card;
    }

    function openSaved() {
      if (!document.body.classList.contains("bridged") ||
          !window.pywebview.api.saved_items || !savedModal) return;
      pywebview.api.saved_items().then(function (res) {
        var items = (res && res.items) || [];
        savedList.replaceChildren();
        items.forEach(function (item) { savedList.appendChild(savedCard(item)); });
        savedEmpty.hidden = items.length > 0;
        savedEmpty.textContent = "Chưa có bài nào được lưu.";
        savedModal.hidden = false;
      }).catch(function () {
        savedList.replaceChildren();
        savedEmpty.textContent = "Không tải được danh sách đã lưu.";
        savedEmpty.hidden = false;
        savedModal.hidden = false;
      });
    }

    var savedOpen = document.getElementById("saved-open");
    if (savedOpen) savedOpen.addEventListener("click", openSaved);
    var savedClose = document.getElementById("saved-close");
    if (savedClose) savedClose.addEventListener("click", closeSaved);
    if (savedModal) {
      savedModal.addEventListener("click", function (ev) {
        if (ev.target === savedModal) closeSaved();
      });
    }
    document.addEventListener("keydown", function (ev) {
      if (ev.key === "Escape") closeSaved();
    });

    /* --- undo an accidental unsave: snackbar backed by feedback.jsonl --- */
    var undoBar = document.getElementById("undo-bar");
    var undoText = document.getElementById("undo-text");
    var undoBtn = document.getElementById("undo-btn");
    var undoTimer = null;
    var undoUid = null;

    function hideUndo() {
      if (!undoBar) return;
      undoBar.hidden = true;
      undoUid = null;
      if (undoTimer) {
        clearTimeout(undoTimer);
        undoTimer = null;
      }
    }

    function showUndo(uid) {
      if (!undoBar || !undoBtn || !undoText) return;
      undoUid = uid;
      undoText.textContent = "Đã bỏ lưu.";
      undoBtn.textContent = "Hoàn tác";
      undoBtn.disabled = false;
      undoBar.hidden = false;
      if (undoTimer) clearTimeout(undoTimer);
      undoTimer = setTimeout(hideUndo, 20000);
    }

    if (undoBtn) {
      undoBtn.addEventListener("click", function () {
        if (!undoUid || undoBtn.disabled ||
            !window.pywebview.api.undo_unsave) return;
        var uid = undoUid;
        undoBtn.disabled = true;
        pywebview.api.undo_unsave(uid).then(function (res) {
          if (res && res.ok) {
            setSavedByUid(uid, true);
            hideUndo();
            if (savedModal && !savedModal.hidden) openSaved();
          } else {
            undoText.textContent = "Không hoàn tác được.";
            undoBtn.disabled = false;
          }
        }).catch(function () {
          undoText.textContent = "Không hoàn tác được.";
          undoBtn.disabled = false;
        });
      });
    }

    /* --- find newer articles: detached run --force --new-only --- */
    var refreshBtn = document.getElementById("refresh-now");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", function () {
        if (!document.body.classList.contains("bridged") ||
            !window.pywebview.api.refresh || refreshBtn.disabled) return;
        var label = refreshBtn.textContent;
        refreshBtn.disabled = true;
        refreshBtn.textContent = "Đang tìm…";
        pywebview.api.refresh().then(function (res) {
          refreshBtn.textContent = (res && res.ok) ? "Đã gửi" : "Thử lại sau";
          setTimeout(function () {
            refreshBtn.textContent = label;
            refreshBtn.disabled = false;
          }, 4000);
        }).catch(function () {
          refreshBtn.textContent = "Thử lại sau";
          setTimeout(function () {
            refreshBtn.textContent = label;
            refreshBtn.disabled = false;
          }, 4000);
        });
      });
    }

    function sendAsk(card) {
      var uid = card.getAttribute("data-uid");
      var input = card.querySelector(".ask-input");
      var out = card.querySelector(".ask-answer");
      var btn = card.querySelector(".ask-btn");
      var q = (input.value || "").trim();
      if (!q || btn.disabled) return;
      out.innerHTML = '<span class="dots"><span></span><span></span><span></span></span>';
      btn.disabled = true;
      pywebview.api.ask(uid, q).then(function (answer) {
        out.textContent = answer || "(không có câu trả lời)";
        btn.disabled = false;
      }).catch(function (err) {
        out.textContent = "Lỗi: " + err;
        btn.disabled = false;
      });
    }

    document.addEventListener("click", function (ev) {
      var btn = ev.target.closest("[data-ask]");
      if (!btn || !document.body.classList.contains("bridged")) return;
      sendAsk(btn.closest("[data-uid]"));
    });

    document.addEventListener("keydown", function (ev) {
      if (ev.key !== "Enter" || !ev.ctrlKey) return;
      if (!document.body.classList.contains("bridged")) return;
      var input = ev.target.closest ? ev.target.closest(".ask-input") : null;
      if (input) { ev.preventDefault(); sendAsk(input.closest("[data-uid]")); }
    });
  })();
</script>
<script>
  (function () {
    var links = document.querySelectorAll('.section-nav a[href^="#"]');
    if (!("IntersectionObserver" in window) || !links.length) return;
    var byId = {};
    links.forEach(function (a) { byId[a.getAttribute("href").slice(1)] = a; });
    var targets = [];
    links.forEach(function (a) {
      var t = document.getElementById(a.getAttribute("href").slice(1));
      if (t) targets.push(t);
    });
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        links.forEach(function (a) {
          a.classList.remove("active");
          a.removeAttribute("aria-current");
        });
        var link = byId[entry.target.id];
        if (link) {
          link.classList.add("active");
          link.setAttribute("aria-current", "page");
        }
      });
    }, { rootMargin: "-45% 0px -50% 0px", threshold: 0 });
    targets.forEach(function (t) { observer.observe(t); });
  })();
</script>
</body>
</html>
