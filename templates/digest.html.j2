<!DOCTYPE html>
<html lang="{{ locale }}" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daily AI Digest — {{ date }}</title>
<style>
{% include "newsroom.css.j2" %}
</style>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <defs>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"/></symbol>
    <symbol id="i-thumb-up" viewBox="0 0 24 24"><path d="M7 11v9M7 11l4-7c.6-1 2-1.2 2.8-.4.4.4.6 1 .5 1.5L13.5 9H18a2 2 0 0 1 2 2.3l-1.2 6A2 2 0 0 1 16.8 19H7M7 11H5a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/></symbol>
    <symbol id="i-thumb-down" viewBox="0 0 24 24"><path d="M7 13V4M7 13l4 7c.6 1 2 1.2 2.8.4.4-.4.6-1 .5-1.5L13.5 15H18a2 2 0 0 0 2-2.3l-1.2-6A2 2 0 0 0 16.8 5H7M7 13H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h2"/></symbol>
    <symbol id="i-bookmark" viewBox="0 0 24 24"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 17v5M9 3h6l1 7 2 2H6l2-2 1-7z"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5"/></symbol>
    <symbol id="i-send" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/></symbol>
  </defs>
</svg>
<div class="wrap">
  <header class="masthead" id="top">
    <div class="masthead-top">
      <span class="edition">{{ t.edition }}</span>
      <div class="masthead-actions">
        <select id="lang-switch" class="lang-switch" aria-label="{{ t.settings_language }}" title="{{ t.settings_language }}">
          {% for code, label in languages %}<option value="{{ code }}"{% if code == locale %} selected{% endif %}>{{ label }}</option>{% endfor %}
        </select>
        <span id="lang-status" class="lang-status" role="status" aria-live="polite" hidden></span>
        <button class="act bridge-only masthead-action" id="saved-open" type="button" title="{{ t.masthead_saved_title }}">{{ t.masthead_saved }}</button>
        <button class="act bridge-only masthead-action" id="refresh-now" type="button" title="{{ t.masthead_refresh_title }}">{{ t.masthead_refresh }}</button>
        <button id="theme-toggle" class="theme-toggle" aria-label="{{ t.theme_toggle }}" title="{{ t.theme_toggle }}">
          <svg class="icon icon-moon" aria-hidden="true"><use href="#i-moon"/></svg>
          <svg class="icon icon-sun" aria-hidden="true"><use href="#i-sun"/></svg>
        </button>
      </div>
    </div>
    <h1 class="wordmark"><span class="stamp">AI</span>Daily AI Digest</h1>
    <div class="dateline">
      <span>{{ date_long or date }} · {{ t.dateline_stories.format(n=total) }}{% if requested_count > total %} · {{ t.dateline_shortfall.format(actual=total, requested=requested_count) }}{% endif %}{% if backfilled_count %} · {{ t.dateline_backfilled.format(n=backfilled_count) }}{% endif %} <button id="size-open" class="size-trigger bridge-only" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="size-modal" title="{{ t.size_trigger_title }}">{{ t.settings_change }}</button></span>
      <span>{{ t.dateline_editor.format(name=(model_name if mode == "llm" else t.mode_demo if mode == "demo" else t.mode_empty if mode == "empty" else t.mode_heuristic)) }}</span>
    </div>
  </header>

  <nav class="section-nav" aria-label="{{ t.nav_aria }}">
    <a href="#top" class="active">{{ t.nav_overview }}</a>
    <a href="#papers">{{ t.nav_papers }}</a>
    <a href="#tech-news">{{ t.nav_tech }}</a>
    <a href="#tools-releases">{{ t.nav_tools }}</a>
    {% if pinned %}<a href="#pinned" class="pinned-link">{{ t.nav_pinned }}</a>{% endif %}
    <span class="section-nav-indicator" aria-hidden="true"></span>
  </nav>

  {% if notice_lines %}
  <div class="status-strip notice">{% if notice_lines %}{{ notice_lines[0] }}{% for line in notice_lines[1:] %}<p class="status-line">{{ line }}</p>{% endfor %}{% endif %}</div>
  {% elif notice %}
  <div class="status-strip notice">{{ notice }}</div>
  {% endif %}
  {% if degraded %}
  <div class="status-strip degraded">
    {{ t.degraded }}{% if sources_failed %} {{ t.degraded_sources.format(sources=sources_failed | join(", ")) }}{% endif %}
    {{ t.degraded_details.format(path="logs/daily-digest.log") }}
  </div>
  {% endif %}

  {% from "partials/_story.html.j2" import story, pinned_item, rail, most_read, source_line with context %}

  {% set rail_content = (overview and not section_briefs) or pinned or pinned_overflow %}
  {% if front_page.lead %}
  <div class="top-fold{% if not rail_content %} top-fold--wide{% endif %}">
    <div class="hero-col">
      {{ story(front_page.lead, "hero") }}
      {% if front_page.secondary %}
      <div class="cover-pair{% if not front_page.most_read %} cover-pair--single{% endif %}">
        {{ story(front_page.secondary, "feature") }}
        {{ most_read() }}
      </div>
      {% else %}
      {{ most_read() }}
      {% endif %}
    </div>
    {% if rail_content %}{{ rail() }}{% endif %}
  </div>
  {% else %}
  <div class="top-fold top-fold--empty{% if not rail_content %} top-fold--wide{% endif %}">
    <div class="empty-note">{{ t.empty_none }}</div>
    {% if rail_content %}{{ rail() }}{% endif %}
  </div>
  {% endif %}
  {% if not rail_content %}{{ source_line() }}{% endif %}

  {% for section in front_page.sections %}
  {% set section_key = section.key %}
  {% set first_section = loop.first %}
  {% set shown = (1 if section.lead else 0) + (section.briefs | length) %}
  {% set more_items = section.briefs[6:] %}
  {% set more_count = (section.briefs | length) - 6 %}
  {% set section_variant = "empty" if section.total == 0 else ("hero-only" if section.lead is none else ("band" if section.briefs | length == 0 else ("split" if section.briefs | length <= 3 else "grid"))) %}
  <section class="section-front sec-{{ section_key }} section-front--{{ section_variant }}" id="{{ section_key | replace('_', '-') }}">
    <div class="section-head">
      <span class="idx">{{ "%02d" | format(loop.index) }}</span>
      <h2>{{ section_titles.get(section_key, section.title) }}</h2>
      <span class="count">{{ t.section_count.format(n=section.total) }}{% if section.total > shown %} · {{ t.section_above.format(n=section.total - shown) }}{% endif %}</span>
    </div>
    {% set brief = section_brief_map.get(section_key) %}
    {% if brief %}
    <div class="section-summary">
      {% if brief.segments %}
      <p class="section-summary-text">{% for seg in brief.segments %}{{ seg.text }}{% if seg.ref %}<a class="oref" href="#story-{{ seg.ref.uid }}" data-story-ref="{{ seg.ref.uid }}" title="{{ seg.ref.title }}" aria-label="{{ t.overview_jump_aria.format(title=seg.ref.title) }}">{{ seg.ref.label }}</a>{% endif %}{% endfor %}</p>
      {% else %}
      <p class="section-summary-text">{{ brief.text }}</p>
      {% if brief.refs %}
      <div class="section-summary-refs">
        {% for ref in brief.refs %}<a class="oref" href="#story-{{ ref.uid }}" data-story-ref="{{ ref.uid }}" title="{{ ref.title }}" aria-label="{{ t.overview_jump_aria.format(title=ref.title) }}">{{ ref.label }}</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}{% endfor %}
      </div>
      {% endif %}
      {% if brief.coverage_refs %}
      <div class="section-summary-coverage">
        <span class="coverage-label">{{ t.section_coverage_all.format(n=brief.coverage_refs | length) }}</span>
        {% for chunk in brief.coverage_refs | batch(8, none) %}
        <p class="coverage-line">{% for ref in chunk if ref %}<a class="oref" href="#story-{{ ref.uid }}" data-story-ref="{{ ref.uid }}" title="{{ ref.title }}" aria-label="{{ t.overview_jump_aria.format(title=ref.title) }}">{{ ref.label }}</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}{% endfor %}</p>
        {% endfor %}
      </div>
      {% endif %}
      {% endif %}
    </div>
    {% endif %}

    {% if section.total == 0 %}
    <p class="empty-note">{{ t.section_empty }}</p>
    {% elif section.lead is none %}
    <p class="section-note">{{ t.section_lead_above }}</p>
    {% else %}
    <div class="section-body">
      <div class="lead-col">
        {{ story(section.lead, "lead") }}
      </div>
      {% if section.briefs %}
      <div class="briefs">
        {% for r in section.briefs[:6] %}{% if first_section and loop.first %}{{ story(r, "feature") }}{% else %}{{ story(r, "brief") }}{% endif %}{% endfor %}
      </div>
      {% endif %}
    </div>
    {% if more_items %}
    <div class="section-more{% if more_items|length == 1 %} section-more--single{% endif %}"
         role="group" aria-labelledby="more-{{ section_key | replace('_','-') }}">
      <div class="more-head">
        <h3 id="more-{{ section_key | replace('_','-') }}">{{ t.section_more }}</h3>
        <span class="more-count">{{ t.section_more_count.format(n=more_count) }}</span>
      </div>
      <div class="more-list">
        {% for r in more_items %}{{ story(r, "more") }}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% endif %}
  </section>
  {% endfor %}

  <footer>
    {{ t.footer }}
  </footer>
</div>

<div id="saved-modal" class="saved-modal" role="dialog" aria-modal="true" aria-labelledby="saved-title" hidden>
  <div class="saved-modal__panel">
    <div class="saved-modal__head">
      <h2 id="saved-title">{{ t.saved_title }}</h2>
      <button id="saved-close" class="act" type="button" aria-label="{{ t.saved_close }}">×</button>
    </div>
    <div id="saved-list" class="saved-list"></div>
    <p id="saved-empty" class="empty-note" hidden>{{ t.saved_empty }}</p>
  </div>
</div>

<div id="size-modal" class="size-modal" role="dialog" aria-modal="true" aria-labelledby="size-title" hidden>
  <div class="size-modal__panel">
    <div class="size-modal__head">
      <h2 id="size-title">{{ t.settings_title }}</h2>
      <button id="size-close" class="act" type="button" aria-label="{{ t.settings_close }}">×</button>
    </div>
    <p id="size-help" class="size-note">{{ t.settings_help }}</p>
    <div class="size-stepper" role="group" aria-label="{{ t.settings_size_group }}">
      <button id="size-minus" class="act" type="button" aria-label="{{ t.settings_minus }}">−</button>
      <output id="size-value" class="size-value" aria-live="polite" aria-label="{{ t.settings_value_aria }}">12</output>
      <button id="size-plus" class="act" type="button" aria-label="{{ t.settings_plus }}">+</button>
    </div>
    <p id="size-current" class="size-note">{{ t.settings_current.format(n=total) }}</p>
    <label class="size-language" for="size-language">{{ t.settings_language }}</label>
    <select id="size-language" class="size-language-select">
      {% for code, label in languages %}<option value="{{ code }}"{% if code == locale %} selected{% endif %}>{{ label }}</option>{% endfor %}
    </select>
    <p class="size-note">{{ t.settings_language_help }}</p>
    <p id="size-warning" class="size-note size-warning" hidden></p>
    <p id="size-status" class="size-status" role="status" aria-live="polite"></p>
    <div class="size-actions">
      <button id="size-apply" class="act size-apply" type="button">{{ t.settings_apply }}</button>
      <button id="size-reset" class="act" type="button">{{ t.settings_reset }}</button>
    </div>
  </div>
</div>

<div id="undo-bar" class="undo-bar" role="status" aria-live="polite" hidden>
  <span id="undo-text">{{ t.undo_saved }}</span>
  <button id="undo-btn" class="act" type="button">{{ t.undo_button }}</button>
</div>

{% if digest_data %}
<script type="application/json" id="digest-data">{{ digest_data | tojson }}</script>
{% endif %}
<script type="application/json" id="digest-i18n">{{ messages | tojson }}</script>
<script>
  (function () {
    var M = {};
    try { M = JSON.parse(document.getElementById("digest-i18n").textContent); } catch (e) { M = {}; }
    function mt(key) { return M[key] || key; }
    /* --- theme: default follows the system; toggle persists in localStorage --- */
    var KEY = "digest-theme";
    function applyTheme(t) {
      if (t === "light" || t === "dark") {
        document.documentElement.setAttribute("data-theme", t);
      } else {
        document.documentElement.removeAttribute("data-theme");
      }
    }
    try { applyTheme(localStorage.getItem(KEY)); } catch (e) { /* storage unavailable: system default */ }
    var toggle = document.getElementById("theme-toggle");
    if (toggle) {
      toggle.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-theme");
        var effective = current || "light";
        var next = effective === "dark" ? "light" : "dark";
        applyTheme(next);
        try { localStorage.setItem(KEY, next); } catch (e2) { /* per-session only */ }
      });
    }

    /* --- language switch: bridge rebuild, or pre-rendered demo files --- */
    var langSwitch = document.getElementById("lang-switch");
    var langStatus = document.getElementById("lang-status");
    function pollLocalization(api) {
      var attempts = 0;
      function tick() {
        if (!langStatus) return;
        attempts += 1;
        if (attempts > 120) {
          langStatus.textContent = mt("settings_error_save");
          return;
        }
        if (!api.localization_status) return;
        api.localization_status().then(function (st) {
          if (!st || st.state === "running" || st.state === "idle") {
            setTimeout(tick, 1500);
          } else if (st.state === "error") {
            langSwitch.value = document.documentElement.lang;
            langStatus.textContent = st.message || mt("settings_error_save");
          } else if (st.state === "degraded") {
            langStatus.textContent = mt("localize_fallback");
          } else if (st.state === "success") {
            langStatus.textContent = mt("settings_updating");
          }
        }).catch(function () {
          setTimeout(tick, 1500);
        });
      }
      tick();
    }
    if (langSwitch) {
      langSwitch.addEventListener("change", function () {
        var target = langSwitch.value;
        var api = window.pywebview && window.pywebview.api ? window.pywebview.api : null;
        if (api && api.set_language) {
          if (!window.confirm(mt("settings_drift_warning"))) {
            langSwitch.value = document.documentElement.lang;
            return;
          }
          langSwitch.disabled = true;
          if (langStatus) {
            langStatus.textContent = mt("settings_updating");
            langStatus.hidden = false;
          }
          api.set_language(target).then(function (res) {
            langSwitch.disabled = false;
            if (!res || !res.ok) {
              langSwitch.value = document.documentElement.lang;
              if (langStatus) {
                langStatus.textContent =
                  (res && res.error) || mt("settings_error_save");
              }
            } else if (langStatus) {
              if (res.spawned) {
                langStatus.textContent = mt("settings_updating");
                pollLocalization(api);
              } else {
                langStatus.hidden = true;
              }
            }
          }).catch(function () {
            langSwitch.disabled = false;
            langSwitch.value = document.documentElement.lang;
            if (langStatus) {
              langStatus.textContent = mt("settings_error_save");
            }
          });
          return;
        }
        if (langStatus) langStatus.hidden = true;
        var file = (window.location.pathname.split("/").pop() || "").toLowerCase();
        if (file.indexOf("demo") === 0) {
          window.location.href = "demo-" + target + ".html";
        } else {
          langSwitch.value = document.documentElement.lang;
        }
      });
    }

    /* --- pywebview bridge: revealed only when the api really exists --- */
    function setRating(button, action) {
      var card = button.closest("[data-uid]");
      if (!card) return;
      card.querySelectorAll('[data-feedback$="|like"], [data-feedback$="|dislike"]')
        .forEach(function (b) {
          b.classList.remove("active");
          b.removeAttribute("data-rating");
        });
      if (action === "like" || action === "dislike") {
        var active = card.querySelector('[data-feedback$="|' + action + '"]');
        if (active) {
          active.classList.add("active");
          active.setAttribute("data-rating", action);
        }
      }
    }

    function applyRatings() {
      if (!document.body.classList.contains("bridged") ||
          !window.pywebview.api.ratings) return;
      pywebview.api.ratings().then(function (res) {
        if (!res || !res.ok) return;
        var ratings = res.ratings || {};
        document.querySelectorAll("[data-uid]").forEach(function (card) {
          var rating = ratings[card.getAttribute("data-uid")];
          if (!rating) return;
          var button = card.querySelector('[data-feedback$="|' + rating + '"]');
          if (button) {
            button.classList.add("active");
            button.setAttribute("data-rating", rating);
          }
        });
      }).catch(function () { /* ratings are decorative */ });
    }

    function setSaved(button, saved) {
      button.classList.toggle("active", saved);
      button.setAttribute("data-saved", saved ? "1" : "0");
      var label = button.querySelector("span");
      if (label) label.textContent = saved ? mt("story_saved") : mt("story_save");
      var text = saved ? mt("story_unsave_title") : mt("story_save_title");
      button.title = text;
      button.setAttribute("aria-label", text);
    }

    function setSavedByUid(uid, saved) {
      document.querySelectorAll('[data-feedback="' + uid + '|save"]')
        .forEach(function (button) { setSaved(button, saved); });
    }

    function applySaved() {
      if (!document.body.classList.contains("bridged") ||
          !window.pywebview.api.saved_items) return;
      pywebview.api.saved_items().then(function (res) {
        if (!res || !res.ok) return;
        var saved = {};
        (res.items || []).forEach(function (item) {
          if (item.uid) saved[item.uid] = true;
        });
        document.querySelectorAll('[data-feedback$="|save"]').forEach(function (button) {
          var uid = button.getAttribute("data-feedback").split("|")[0];
          setSaved(button, !!saved[uid]);
        });
      }).catch(function () { /* default labels stay Lưu */ });
    }

    function ready() {
      if (typeof window.pywebview !== "undefined" &&
          typeof window.pywebview.api !== "undefined" &&
          typeof window.pywebview.api.feedback === "function") {
        document.body.classList.add("bridged");
        applyRatings();
        applySaved();
      }
    }
    window.addEventListener("pywebviewready", ready);

    document.addEventListener("click", function (ev) {
      var btn = ev.target.closest("[data-feedback]");
      if (!btn || !document.body.classList.contains("bridged")) return;
      var parts = btn.getAttribute("data-feedback").split("|");
      var action = parts[1];
      var isSave = action === "save";
      var isRating = action === "like" || action === "dislike";
      if (isRating) {
        var current = btn.getAttribute("data-rating") ||
          (btn.classList.contains("active") ? action : "");
        if (current === action) {
          action = action === "like" ? "unlike" : "undislike";
        }
      }
      btn.classList.remove("done", "failed");
      var request = isSave
        ? pywebview.api.toggle_save(parts[0])
        : pywebview.api.feedback(parts[0], action);
      request.then(function (res) {
        if (res && res.ok) {
          if (isSave) {
            setSavedByUid(parts[0], !!res.saved);  /* Lưu <-> Đã lưu, one button */
          } else if (isRating) {
            setRating(btn, action);
          } else {
            btn.classList.add("done");
          }
          if (!isSave && action === "unsave") {
            setSavedByUid(parts[0], false);
            var savedCard = btn.closest(".saved-card");
            if (savedCard) savedCard.remove();  /* modal is live; rail stays static */
            showUndo(parts[0]);
          }
        }
        else { btn.classList.add("failed"); }
      }).catch(function () { btn.classList.add("failed"); });
    });

    /* --- story references: smooth scroll + focus + 2.5s highlight --- */
    function flashStory(target) {
      if (!target) return;
      target.classList.remove("is-flash");
      void target.offsetWidth;
      target.classList.add("is-flash");
      clearTimeout(target._flashTimer);
      target._flashTimer = setTimeout(function () {
        target.classList.remove("is-flash");
      }, 2500);
    }

    function focusStory(target) {
      if (!target) return;
      target.setAttribute("tabindex", "-1");
      try { target.focus({ preventScroll: true }); }
      catch (e) { target.focus(); }
    }

    document.addEventListener("click", function (ev) {
      var link = ev.target.closest
        ? ev.target.closest('a[data-story-ref], a[href^="#story-"]')
        : null;
      if (!link) return;
      var href = link.getAttribute("href") || "";
      if (href.indexOf("#story-") !== 0) return;
      var id = href.slice(1);
      var target = document.getElementById(id);
      if (!target) return;  /* native fragment fallback if the card is absent */
      ev.preventDefault();
      var reduce = window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({
        behavior: reduce ? "auto" : "smooth",
        block: "start",
      });
      focusStory(target);
      flashStory(target);
      try { history.replaceState(null, "", "#" + id); }
      catch (e) { /* hash is best-effort in the pywebview string document */ }
    });

    window.addEventListener("load", function () {
      try {
        var hash = window.location.hash || "";
        if (hash.indexOf("#story-") !== 0) return;
        var target = document.getElementById(hash.slice(1));
        if (!target) return;
        target.scrollIntoView({ behavior: "auto", block: "start" });
        focusStory(target);
        flashStory(target);
      } catch (e) { /* deep links are best-effort */ }
    });

    /* --- saved articles modal: all saves, read live from the bridge --- */
    var savedModal = document.getElementById("saved-modal");
    var savedList = document.getElementById("saved-list");
    var savedEmpty = document.getElementById("saved-empty");

    function closeSaved() {
      if (savedModal) savedModal.hidden = true;
    }

    function savedCard(item) {
      var card = document.createElement("article");
      card.className = "saved-card";
      var link = document.createElement("a");
      link.href = item.href || "#";
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = item.title || mt("saved_no_title");
      var heading = document.createElement("h3");
      heading.appendChild(link);
      card.appendChild(heading);

      var meta = document.createElement("div");
      meta.className = "meta";
      var bits = [item.source_label || item.source || "", "", ""];
      if (item.points) bits[1] = item.points + " points";
      if (item.citations) bits[2] = item.citations + " citations";
      bits.forEach(function (text) {
        if (!text) return;
        var span = document.createElement("span");
        span.textContent = text;
        meta.appendChild(span);
      });
      card.appendChild(meta);

      var summary = item.llm_summary || item.summary || "";
      if (summary) {
        var p = document.createElement("p");
        p.className = "summary";
        p.textContent = summary;
        card.appendChild(p);
      }

      var unsave = document.createElement("button");
      unsave.type = "button";
      unsave.className = "act";
      unsave.textContent = mt("story_done");
      unsave.setAttribute("data-feedback", (item.uid || "") + "|unsave");
      card.appendChild(unsave);
      return card;
    }

    function openSaved() {
      if (!document.body.classList.contains("bridged") ||
          !window.pywebview.api.saved_items || !savedModal) return;
      pywebview.api.saved_items().then(function (res) {
        var items = (res && res.items) || [];
        savedList.replaceChildren();
        items.forEach(function (item) { savedList.appendChild(savedCard(item)); });
        savedEmpty.hidden = items.length > 0;
        savedEmpty.textContent = mt("saved_empty");
        savedModal.hidden = false;
      }).catch(function () {
        savedList.replaceChildren();
        savedEmpty.textContent = mt("saved_load_error");
        savedEmpty.hidden = false;
        savedModal.hidden = false;
      });
    }

    var savedOpen = document.getElementById("saved-open");
    if (savedOpen) savedOpen.addEventListener("click", openSaved);
    var savedClose = document.getElementById("saved-close");
    if (savedClose) savedClose.addEventListener("click", closeSaved);
    if (savedModal) {
      savedModal.addEventListener("click", function (ev) {
        if (ev.target === savedModal) closeSaved();
      });
    }
    document.addEventListener("keydown", function (ev) {
      if (ev.key === "Escape") closeSaved();
    });

    /* --- digest-size dialog: one preference, rebuild on apply --- */
    var sizeModal = document.getElementById("size-modal");
    var sizeOpen = document.getElementById("size-open");
    var sizeValue = document.getElementById("size-value");
    var sizeMinus = document.getElementById("size-minus");
    var sizePlus = document.getElementById("size-plus");
    var sizeApply = document.getElementById("size-apply");
    var sizeReset = document.getElementById("size-reset");
    var sizeClose = document.getElementById("size-close");
    var sizeHelp = document.getElementById("size-help");
    var sizeCurrent = document.getElementById("size-current");
    var sizeWarning = document.getElementById("size-warning");
    var sizeStatus = document.getElementById("size-status");
    var sizeLanguage = document.getElementById("size-language");
    var sizeReturnFocus = null;
    var sizeState = {
      value: 12,
      min: 1,
      max: 30,
      default: 12,
      current: 0,
      language: document.documentElement.lang || "vi",
      stored: null,
      can_change: false,
      has_key: false,
      archived: false,
      busy: false,
    };

    function isSizeUnchanged() {
      return sizeState.value === sizeState.current &&
        (sizeState.stored === null || sizeState.stored === sizeState.value);
    }

    function sizeApi() {
      return window.pywebview && window.pywebview.api ? window.pywebview.api : null;
    }

    function updateSize() {
      if (sizeValue) sizeValue.textContent = String(sizeState.value);
      if (sizeHelp) {
        sizeHelp.textContent = mt("settings_help")
          .replace("{min}", sizeState.min)
          .replace("{max}", sizeState.max)
          .replace("{default}", sizeState.default);
      }
      if (sizeCurrent) {
        sizeCurrent.textContent = mt("settings_current").replace("{n}", sizeState.current);
      }
      var disabled = sizeState.busy || !sizeState.can_change;
      var languageChanged = sizeLanguage && sizeLanguage.value !== sizeState.language;
      var sizeChanged = !isSizeUnchanged();
      if (sizeMinus) sizeMinus.disabled = disabled || sizeState.value <= sizeState.min;
      if (sizePlus) sizePlus.disabled = disabled || sizeState.value >= sizeState.max;
      if (sizeApply) {
        sizeApply.disabled = disabled || (isSizeUnchanged() && !languageChanged);
      }
      if (sizeReset) sizeReset.disabled = disabled;
      if (sizeWarning) {
        var warning = "";
        if (sizeState.archived) {
          warning = mt("settings_archived");
        } else if (sizeChanged) {
          warning = mt("settings_size_warning");
        } else if (languageChanged) {
          warning = mt("settings_drift_warning");
        } else if (!sizeState.has_key) {
          warning = mt("settings_no_key");
        }
        sizeWarning.textContent = warning;
        sizeWarning.hidden = !warning;
      }
    }

    function closeSize() {
      if (!sizeModal) return;
      sizeModal.hidden = true;
      if (sizeOpen) sizeOpen.setAttribute("aria-expanded", "false");
      if (sizeReturnFocus && sizeReturnFocus.focus) sizeReturnFocus.focus();
      sizeReturnFocus = null;
    }

    function openSize() {
      var api = sizeApi();
      if (!api || !api.settings || !api.apply_settings || !sizeModal) return;
      sizeReturnFocus = document.activeElement;
      api.settings().then(function (res) {
        if (!res || !res.ok) {
          sizeStatus.textContent = mt("settings_error_read");
          sizeModal.hidden = false;
          if (sizeOpen) sizeOpen.setAttribute("aria-expanded", "true");
          return;
        }
        sizeState.value = res.size;
        sizeState.min = res.min;
        sizeState.max = res.max;
        sizeState.default = res.default;
        sizeState.current = res.current;
        sizeState.stored = res.stored;
        sizeState.language = res.language || document.documentElement.lang || "vi";
        sizeState.can_change = res.can_change;
        sizeState.has_key = res.has_key;
        sizeState.archived = res.archived;
        sizeState.busy = false;
        sizeStatus.textContent = "";
        if (sizeLanguage) sizeLanguage.value = sizeState.language;
        updateSize();
        sizeModal.hidden = false;
        if (sizeOpen) sizeOpen.setAttribute("aria-expanded", "true");
        if (sizeMinus && !sizeMinus.disabled) sizeMinus.focus();
        else if (sizeClose) sizeClose.focus();
      }).catch(function () {
        sizeStatus.textContent = mt("settings_error_read");
        sizeModal.hidden = false;
        if (sizeOpen) sizeOpen.setAttribute("aria-expanded", "true");
      });
    }

    function stepSize(delta) {
      if (sizeState.busy || !sizeState.can_change) return;
      var next = sizeState.value + delta;
      if (next < sizeState.min) next = sizeState.min;
      if (next > sizeState.max) next = sizeState.max;
      sizeState.value = next;
      updateSize();
    }

    function applySize() {
      var api = sizeApi();
      if (!api || !api.apply_settings || sizeState.busy || !sizeState.can_change) return;
      sizeState.busy = true;
      if (sizeStatus) sizeStatus.textContent = mt("settings_saving");
      updateSize();
      api.apply_settings(
        sizeState.value,
        sizeLanguage ? sizeLanguage.value : document.documentElement.lang || "vi"
      ).then(function (res) {
        sizeState.busy = false;
        if (res && res.ok) {
          sizeState.stored = res.size;
          if (res.language) sizeState.language = res.language;
          if (res.spawned) {
            sizeStatus.textContent = mt("settings_updating");
            updateSize();
            setTimeout(closeSize, 1400);
          } else {
            sizeStatus.textContent = mt("settings_saved").replace("{n}", res.size);
            updateSize();
          }
        } else {
          sizeStatus.textContent = (res && res.error) || mt("settings_error_save");
          updateSize();
        }
      }).catch(function () {
        sizeState.busy = false;
        sizeStatus.textContent = mt("settings_error_save");
        updateSize();
      });
    }

    function resetSize() {
      var api = sizeApi();
      if ((!api || !api.reset_settings) && (!api || !api.reset_digest_size)) return;
      if (sizeState.busy || !sizeState.can_change) return;
      sizeState.busy = true;
      if (sizeStatus) sizeStatus.textContent = mt("settings_saving");
      updateSize();
      var call = api.reset_settings
        ? api.reset_settings()
        : api.reset_digest_size();
      call.then(function (res) {
        sizeState.busy = false;
        if (res && res.ok) {
          sizeState.value = res.size;
          sizeState.stored = res.stored;
          if (res.language) sizeState.language = res.language;
          if (sizeLanguage) sizeLanguage.value = sizeState.language;
          sizeStatus.textContent = mt("settings_reset_done").replace("{n}", res.size);
        } else {
          sizeStatus.textContent = (res && res.error) || mt("settings_error_reset");
        }
        updateSize();
      }).catch(function () {
        sizeState.busy = false;
        sizeStatus.textContent = mt("settings_error_reset");
        updateSize();
      });
    }

    if (sizeOpen) sizeOpen.addEventListener("click", openSize);
    if (sizeMinus) sizeMinus.addEventListener("click", function () { stepSize(-1); });
    if (sizePlus) sizePlus.addEventListener("click", function () { stepSize(1); });
    if (sizeApply) sizeApply.addEventListener("click", applySize);
    if (sizeReset) sizeReset.addEventListener("click", resetSize);
    if (sizeLanguage) sizeLanguage.addEventListener("change", updateSize);
    if (sizeClose) sizeClose.addEventListener("click", closeSize);
    if (sizeModal) {
      sizeModal.addEventListener("click", function (ev) {
        if (ev.target === sizeModal) closeSize();
      });
      sizeModal.addEventListener("keydown", function (ev) {
        if (ev.key === "Escape") {
          ev.preventDefault();
          closeSize();
          return;
        }
        if (ev.key !== "Tab") return;
        var focusable = Array.prototype.filter.call(
          sizeModal.querySelectorAll("button:not([disabled]), [href], input:not([disabled])"),
          function (el) { return el.offsetParent !== null; }
        );
        if (!focusable.length) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (ev.shiftKey && document.activeElement === first) {
          ev.preventDefault();
          last.focus();
        } else if (!ev.shiftKey && document.activeElement === last) {
          ev.preventDefault();
          first.focus();
        }
      });
    }

    /* --- undo an accidental unsave: snackbar backed by feedback.jsonl --- */
    var undoBar = document.getElementById("undo-bar");
    var undoText = document.getElementById("undo-text");
    var undoBtn = document.getElementById("undo-btn");
    var undoTimer = null;
    var undoUid = null;

    function hideUndo() {
      if (!undoBar) return;
      undoBar.hidden = true;
      undoUid = null;
      if (undoTimer) {
        clearTimeout(undoTimer);
        undoTimer = null;
      }
    }

    function showUndo(uid) {
      if (!undoBar || !undoBtn || !undoText) return;
      undoUid = uid;
      undoText.textContent = mt("undo_saved");
      undoBtn.textContent = mt("undo_button");
      undoBtn.disabled = false;
      undoBar.hidden = false;
      if (undoTimer) clearTimeout(undoTimer);
      undoTimer = setTimeout(hideUndo, 20000);
    }

    if (undoBtn) {
      undoBtn.addEventListener("click", function () {
        if (!undoUid || undoBtn.disabled ||
            !window.pywebview.api.undo_unsave) return;
        var uid = undoUid;
        undoBtn.disabled = true;
        pywebview.api.undo_unsave(uid).then(function (res) {
          if (res && res.ok) {
            setSavedByUid(uid, true);
            hideUndo();
            if (savedModal && !savedModal.hidden) openSaved();
          } else {
            undoText.textContent = mt("undo_error");
            undoBtn.disabled = false;
          }
        }).catch(function () {
          undoText.textContent = mt("undo_error");
          undoBtn.disabled = false;
        });
      });
    }

    /* --- find newer articles: detached run --force --new-only --- */
    var refreshBtn = document.getElementById("refresh-now");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", function () {
        if (!document.body.classList.contains("bridged") ||
            !window.pywebview.api.refresh || refreshBtn.disabled) return;
        var label = refreshBtn.textContent;
        refreshBtn.disabled = true;
        refreshBtn.textContent = mt("refresh_searching");
        pywebview.api.refresh().then(function (res) {
          refreshBtn.textContent = (res && res.ok) ? mt("refresh_sent") : mt("refresh_retry");
          setTimeout(function () {
            refreshBtn.textContent = label;
            refreshBtn.disabled = false;
          }, 4000);
        }).catch(function () {
          refreshBtn.textContent = mt("refresh_error");
          setTimeout(function () {
            refreshBtn.textContent = label;
            refreshBtn.disabled = false;
          }, 4000);
        });
      });
    }

    function sendAsk(card) {
      var uid = card.getAttribute("data-uid");
      var input = card.querySelector(".ask-input");
      var out = card.querySelector(".ask-answer");
      var btn = card.querySelector(".ask-btn");
      var q = (input.value || "").trim();
      if (!q || btn.disabled) return;
      out.innerHTML = '<span class="dots"><span></span><span></span><span></span></span>';
      btn.disabled = true;
      pywebview.api.ask(uid, q).then(function (answer) {
        out.textContent = answer || mt("ask_no_answer");
        btn.disabled = false;
      }).catch(function (err) {
        out.textContent = mt("ask_error");
        btn.disabled = false;
      });
    }

    document.addEventListener("click", function (ev) {
      var btn = ev.target.closest("[data-ask]");
      if (!btn || !document.body.classList.contains("bridged")) return;
      sendAsk(btn.closest("[data-uid]"));
    });

    document.addEventListener("keydown", function (ev) {
      if (ev.key !== "Enter" || !ev.ctrlKey) return;
      if (!document.body.classList.contains("bridged")) return;
      var input = ev.target.closest ? ev.target.closest(".ask-input") : null;
      if (input) { ev.preventDefault(); sendAsk(input.closest("[data-uid]")); }
    });
  })();
</script>
<script>
  (function () {
    var nav = document.querySelector(".section-nav");
    if (!nav) return;
    var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
    if (!links.length) return;
    var indicator = nav.querySelector(".section-nav-indicator");
    var byId = {};
    var navLockUntil = 0;
    links.forEach(function (a) { byId[a.getAttribute("href").slice(1)] = a; });

    function moveIndicator(link) {
      if (!indicator) return;
      if (!link) { indicator.style.width = "0px"; return; }
      indicator.style.width = link.offsetWidth + "px";
      indicator.style.transform = "translateX(" + link.offsetLeft + "px)";
    }

    function activate(link) {
      links.forEach(function (a) {
        a.classList.remove("active");
        a.removeAttribute("aria-current");
      });
      if (!link) return;
      link.classList.add("active");
      link.setAttribute("aria-current", "page");
      moveIndicator(link);
    }

    activate(nav.querySelector("a.active") || links[0]);
    links.forEach(function (a) {
      a.addEventListener("click", function (ev) {
        var target = document.getElementById(a.getAttribute("href").slice(1));
        if (target) {
          ev.preventDefault();
          navLockUntil = Date.now() + 800;
          var reduce = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          target.scrollIntoView({
            behavior: reduce ? "auto" : "smooth",
            block: "start",
          });
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, "", a.getAttribute("href"));
          }
        }
        activate(a);
      });
    });
    window.addEventListener("resize", function () {
      moveIndicator(nav.querySelector("a.active"));
    });
    window.addEventListener("load", function () {
      moveIndicator(nav.querySelector("a.active"));
    });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        moveIndicator(nav.querySelector("a.active"));
      });
    }

    if (!("IntersectionObserver" in window)) return;
    var targets = [];
    links.forEach(function (a) {
      var t = document.getElementById(a.getAttribute("href").slice(1));
      if (t) targets.push(t);
    });
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting || Date.now() < navLockUntil) return;
        var link = byId[entry.target.id];
        if (link) activate(link);
      });
    }, { rootMargin: "-45% 0px -50% 0px", threshold: 0 });
    targets.forEach(function (t) { observer.observe(t); });
  })();
</script>
</body>
</html>
